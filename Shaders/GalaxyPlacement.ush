#pragma once

// GalaxyPlacement.ush
// Entity placement for the galaxy layer: how a cell decides how many candidates to draw,
// where each lands, and whether it survives. Nothing here reads a texture or evaluates the field;
// UniversePlacement.ush mirrors it.
//
// THE CONTRACT: MakeGalaxyCandidate decides everything keyed on the candidate alone -- position, acceptance
// draw, extent draw, decoratives -- and FinishGalaxyEntity everything needing the density, which the caller
// supplies. A single "sample and place" function would name that source, hardcoding the analytic field and
// putting the textured path permanently out of reach of placement.
//
// PARITY RULES, as in the field, since C++ compiles this the moment a debug probe wants it: suffix every float
// literal (C++ types an unsuffixed one as double), guard every pow() base away from zero, and use no swizzle
// beyond .x/.y/.z/.w, no integer vectors and no HLSL-only intrinsics -- all compile cleanly as HLSL and fail on
// the C++ side alone.

#include "/UltraLargeScale/GalaxyDensityCore.ush"

// GalaxyDensityParams::PowSafe as a free function, since these take no params struct. If one changes, both do.
float GalaxyPowSafe(float x, float p)
{
    return (x > GALAXY_POW_EPSILON) ? pow(x, p) : 0.0f;
}

// Per-tier placement rules, separate from GalaxyDensityParams because these change per tier and the field does
// not. Returned by value, never through an output array -- that needs `out float3 A[N]` in HLSL and a pointer in
// C++, the divergence the no-`out` rule exists to prevent.
struct GalaxyPlacement
{
    // The density reading as a certain spawn, inverted. PER-CALL because every cell rejects against its own
    // probed peak, so the ratio runs order-1 and the cell cancels out of the result exactly.
    float InvDensityReference;
    float SpawnExponent; // 1 = the raw response; <1 spawns more in faint regions
    float ExtentMin; // FINAL caller units -- divide by UnitScale before filling this in
    float ExtentMax;
    float ExtentExponent; // <1 biases small, >1 biases large
};

// The per-candidate key lattice: every key is KeySeed + GALAXY_SLOT_STRIDE * n, candidates taking n >= 0 and
// envelope probes n < 0, so the families cannot collide however large the budget grows. Keys collide only when
// the stride times (nA - nB) equals a difference between tier offsets, so growing the budget is safe and an
// offset reaching the stride is not.
#define GALAXY_SLOT_STRIDE 977
#define GALAXY_DECOR_OFFSET 24337

// A third family, one draw per cell, for GalaxyStochasticCount. Offsets must not share a residue modulo the
// stride.
// A third family, one draw per cell, for GalaxyStochasticCount; offsets must not share a residue mod the stride.
#define GALAXY_ROUND_OFFSET 51749

GalaxyPlacement MakeGalaxyPlacement(
    float InDensityReference, // the density that reads as a certain spawn
    float InSpawnExponent,
    float InExtentMin, // FINAL units: divide by UnitScale before calling
    float InExtentMax,
    float InExtentExponent)
{
    GalaxyPlacement Q;

    Q.InvDensityReference = 1.0f / max(InDensityReference, 1e-3f); // a division guard: zero accepts everything
    Q.SpawnExponent = max(InSpawnExponent, 1e-3f);
    Q.ExtentMin = InExtentMin;
    Q.ExtentMax = InExtentMax;
    Q.ExtentExponent = max(InExtentExponent, 1e-3f);

    return Q;
}

struct GalaxyCandidate // before the field has been consulted
{
    float3 Pos; // caller's units
    float3 Norm; // the same point in the field's [-1,1] frame
    float AcceptDraw; // uniform in [0,1), compared against the spawn probability
    float ExtentDraw; // uniform in [0,1), decorrelated from AcceptDraw
    float3 Decor;
};

struct GalaxyEntity
{
    float3 Pos; // caller's units, same frame as the cell centre passed in
    float Extent;
    float Density; // raw field value at Pos, before any spawn shaping
    float3 Decor; // three decorrelated uniforms in [0,1) for colour, rotation, type
    float bValid; // 0 = rejected; the caller skips it
};

// Stateless four-value hash, ArmHash's wrapping uint arithmetic widened so a cell and a slot both key it. Keying
// on (cell, slot) rather than a sequential stream makes any entity recomputable alone, so one thread makes one
// slot without its predecessors and a region regenerates identically on revisit.
float4 GalaxyKeyHash4(int InA, int InB, int InC, int InD)
{
    // MIXED SEQUENTIALLY, ONE INPUT AT A TIME. Folding in parallel -- (A*p1) ^ (B*p2) ^ (C*p3) ^ (D*p4) --
    // COLLIDES ON MIRRORED CELLS: v ^ -v depends only on v's trailing zero count, every multiplier is odd so the
    // product keeps it, and flipping two axes with equal counts cancels the XOR deltas, so a cell hashes
    // IDENTICALLY to its mirror -- 336 of 512 cells at subdivision 3. A MULTIPLY AND A SHIFT AFTER EVERY TERM
    // breaks it, both needed. MOVING A TERM'S POSITION RESEEDS EVERYTHING.
    uint n = 2166136261u;

    n ^= (uint) InA * 73856093u;
    n *= 2246822519u;
    n ^= n >> 15u;

    n ^= (uint) InB * 19349663u;
    n *= 2246822519u;
    n ^= n >> 15u;

    n ^= (uint) InC * 83492791u;
    n *= 2246822519u;
    n ^= n >> 15u;

    n ^= (uint) InD * 2654435761u;
    n *= 2246822519u;
    n ^= n >> 15u;

    uint a = n * 1664525u + 1013904223u;
    uint b = a * 1664525u + 1013904223u;
    uint c = b * 1664525u + 1013904223u;
    uint d = c * 1664525u + 1013904223u;

    a ^= a >> 16u;
    b ^= b >> 16u;
    c ^= c >> 16u;
    d ^= d >> 16u;
    a *= 1664525u;
    b *= 1664525u;
    c *= 1664525u;
    d *= 1664525u;
    a ^= a >> 16u;
    b ^= b >> 16u;
    c ^= c >> 16u;
    d ^= d >> 16u;

    const float Inv32 = 1.0f / 4294967296.0f;
    return float4(float(a) * Inv32, float(b) * Inv32,
                  float(c) * Inv32, float(d) * Inv32);
}


// The largest value the field can return anywhere, from the derived parameters alone. AVAILABLE BECAUSE Compose
// TAKES A MAX: the layers do not stack, so the bound is the largest of four per-layer bounds rather than a sum
// with no closed form. THE WARP DOES NOT ENTER, remapping the domain rather than scaling a layer; the MODULATION
// does. NOT A REPLACEMENT FOR PROBING but A CORRECTNESS CHECK -- an envelope above this cannot happen with the
// derivation intact, separating a found peak from a fault upstream of the probes.
float GalaxyAnalyticCeiling(GalaxyDensityParams P)
{
    float w = abs(P.NoiseChannelWeights.x) + abs(P.NoiseChannelWeights.y)
            + abs(P.NoiseChannelWeights.z) + abs(P.NoiseChannelWeights.w);

    float modArm = 1.0f + abs(P.NoiseAmountArm) * w;
    float modDisc = 1.0f + abs(P.NoiseAmountDisc) * w;
    float modBulge = 1.0f + abs(P.NoiseAmountBulge) * w;
    float modBg = 1.0f + abs(P.NoiseAmountBackground) * w;

    float lopsided = 1.0f + max(P.DiscLopsidedAmount, 0.0f); // m=1 ramps as rn; ceiling taken at the rim

    // The cross-section reaches 1 on the spine and the host profile is at most 1, so what is left is the largest
    // per-arm strength draw -- read from ArmData, already resolved, so it is the true maximum.
    float armStrength = 0.0f;
    for (int ai = 0; ai < GALAXY_MAX_ARMS; ai++)
    {
        if (ai >= P.ArmN)
        {
            break;
        }
        armStrength = max(armStrength, P.ArmData[ai].z);
    }

    float arm = GalaxyPowSafe(armStrength, P.ArmProfileExponent)
              * P.ArmDensityOverPath * lopsided * modArm;

    float disc = P.DiscDensityOverPath * P.InvDiscRadius
               / max(P.DiscHeightRatio, 1e-6f) * lopsided * modDisc;

    float bulge = P.BulgeDensityOverPath * modBulge;
    float bg = P.BackgroundDensityOverPath * modBg;

    return max(max(arm, disc), max(bulge, bg));
}

// Density -> acceptance probability. The field is an OPTICAL DEPTH, not a probability: it peaks in the hundreds
// while most of the volume sits below 0.01, so clamping to [0,1] would accept every candidate across the arms,
// inner disc and bulge at once. A POWER LAW AND IT MUST STAY ONE -- per-cell normalisation is artifact-free only
// because the envelope cancels, budget scaling as E^g against acceptance (d/E)^g, and a soft knee would put the
// cell back into the result and turn every boundary into a visible step.
float GalaxySpawnProbability(float InDensity, GalaxyPlacement InPlace)
{
    if (InDensity <= 0.0f)
    {
        return 0.0f;
    }

    float ratio = min(InDensity * InPlace.InvDensityReference, 1.0f); // NOT named `linear` -- reserved in HLSL

    return saturate(GalaxyPowSafe(ratio, InPlace.SpawnExponent)); // SpawnExponent arrives floored already
}

// A sample point inside a cell, for estimating its density ENVELOPE before any candidate is drawn. Eight corners
// then jitter: corners alone miss an arm crossing a cell's middle, jitter alone misses a peak on a vertex. The
// jitter key runs DOWNWARD from the cell seed while candidates run upward.
float3 MakeGalaxyProbe(float3 InCellCentre, float InCellExtent,
                 int InCellX, int InCellY, int InCellZ,
                 int InKeySeed, uint InProbeIndex)
{
    if (InProbeIndex < 8u)
    {
        return float3(
            InCellCentre.x + ((InProbeIndex & 1u) != 0u ? InCellExtent : -InCellExtent),
            InCellCentre.y + ((InProbeIndex & 2u) != 0u ? InCellExtent : -InCellExtent),
            InCellCentre.z + ((InProbeIndex & 4u) != 0u ? InCellExtent : -InCellExtent));
    }

    float4 h = GalaxyKeyHash4(InCellX, InCellY, InCellZ,
                     InKeySeed - (int) (InProbeIndex + 1u) * GALAXY_SLOT_STRIDE);

    return float3(
        InCellCentre.x + (h.x * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.y + (h.y * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.z + (h.z * 2.0f - 1.0f) * InCellExtent);
}

// Three decorrelated uniforms in [0,1) in one 32-bit word, ten bits each -- halves the entity record, and 1024
// levels per channel is past what a colour target carries. THE WORD MUST STAY IN AN INTEGER BUFFER: read as a
// float, an arbitrary pattern can land on a denormal or a NaN. SCALAR ONLY, per the parity subset.
uint PackGalaxyDecor(float3 InDecor)
{
    uint qx = (uint) (saturate(InDecor.x) * 1023.0f + 0.5f);
    uint qy = (uint) (saturate(InDecor.y) * 1023.0f + 0.5f);
    uint qz = (uint) (saturate(InDecor.z) * 1023.0f + 0.5f);

    return qx | (qy << 10u) | (qz << 20u);
}

float3 UnpackGalaxyDecor(uint InPacked)
{
    const float Inv = 1.0f / 1023.0f;

    return float3(
        (float) (InPacked & 1023u) * Inv,
        (float) ((InPacked >> 10u) & 1023u) * Inv,
        (float) ((InPacked >> 20u) & 1023u) * Inv);
}

// How many candidates a cell draws, from a real-valued budget. STOCHASTIC, NOT ROUNDED OR FLOORED: most of a
// galaxy is faint, so a budget is often a small fraction and deterministic rounding destroys the bottom end:
// floor of 1 makes the halo's count track CELL COUNT rather than density, plain rounding empties everything
// below half a candidate. Adding one with probability frac() has expectation exactly InRaw, and the draw is keyed
// on the cell alone, so it is WAVE-UNIFORM and the strided candidate loop cannot diverge.
uint GalaxyStochasticCount(float InRaw, int InCellX, int InCellY, int InCellZ,
                     int InKeySeed, float InCeiling)
{
    float r = min(max(InRaw, 0.0f), InCeiling);

    // NOT named `frac`: shadowing an HLSL intrinsic is accepted by some compilers and rejected by others.
    float whole = floor(r);
    float fracPart = r - whole;

    float4 h = GalaxyKeyHash4(InCellX, InCellY, InCellZ, InKeySeed + GALAXY_ROUND_OFFSET);

    return (uint) whole + ((h.x < fracPart) ? 1u : 0u);
}

// One candidate, decided entirely by its own key. InCellCentre and InCellExtent are in the caller's units, and
// InInvGalaxyExtent converts to the field's [-1,1] frame -- passed in rather than stored where it could drift.
GalaxyCandidate MakeGalaxyCandidate(float3 InCellCentre, float InCellExtent,
                              float InInvGalaxyExtent, int InCellX, int InCellY,
                              int InCellZ, int InSlot)
{
    GalaxyCandidate C;

    float4 h = GalaxyKeyHash4(InCellX, InCellY, InCellZ, InSlot);

    C.Pos = float3(
        InCellCentre.x + (h.x * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.y + (h.y * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.z + (h.z * 2.0f - 1.0f) * InCellExtent);

    C.Norm = float3(C.Pos.x * InInvGalaxyExtent,
                    C.Pos.y * InInvGalaxyExtent,
                    C.Pos.z * InInvGalaxyExtent);

    C.AcceptDraw = h.w;

    // MUST NOT REUSE AcceptDraw or share a component with it: acceptance keeps only draws below p, so among
    // survivors it is biased low, and sharing it leaves sparse regions holding systematically tiny stars.
    float e = h.x * 7.31f + h.y * 3.17f + h.z * 11.71f;
    C.ExtentDraw = e - floor(e);

    float4 g = GalaxyKeyHash4(InCellX, InCellY, InCellZ, InSlot + GALAXY_DECOR_OFFSET);
    C.Decor = float3(g.x, g.y, g.z);

    return C;
}

// InDensity is the RAW field value at C.Norm: SampleAnalytic for the texture-free path, GalaxySample otherwise.
GalaxyEntity FinishGalaxyEntity(GalaxyPlacement InPlace, GalaxyCandidate InC,
                          float InDensity)
{
    GalaxyEntity E;

    E.Pos = InC.Pos;
    E.Density = InDensity;
    E.Decor = InC.Decor;
    E.bValid = (InC.AcceptDraw < GalaxySpawnProbability(InDensity, InPlace))
        ? 1.0f : 0.0f;

    E.Extent = InPlace.ExtentMin
        + (InPlace.ExtentMax - InPlace.ExtentMin)
          * GalaxyPowSafe(InC.ExtentDraw, InPlace.ExtentExponent);

    return E;
}
