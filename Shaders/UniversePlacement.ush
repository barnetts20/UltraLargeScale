#pragma once

// UniversePlacement.ush
// Entity placement for the universe layer: how a cell decides how many candidates to draw, where each lands, and
// whether it survives. Nothing here reads a texture or evaluates the field; GalaxyPlacement.ush mirrors it.
//
// THE CONTRACT: MakeUniverseCandidate decides everything keyed on the candidate alone -- position, acceptance
// draw, extent draw, decoratives -- and FinishUniverseEntity everything needing the density. A single "sample
// and place" function would name that source, hardcoding the analytic field and putting the textured path out of
// reach, worse here than for the galaxy: two region and three warp fetches turned neutral change the GEOMETRY.
// PARITY RULES apply as in the field, since C++ compiles this the moment a debug probe wants it -- suffix every
// float literal, guard every pow() base away from zero, and use no swizzle beyond .x/.y/.z/.w, no integer
// vectors, no HLSL-only intrinsics.

#include "/UltraLargeScale/UniverseDensityCore.ush"

// The per-candidate key lattice: every key is CellSeed + UNIVERSE_SLOT_STRIDE * n, candidates taking n >= 0 and
// envelope probes n < 0, so the families cannot collide however large the budget grows. Keys collide only when
// the stride times a slot difference equals a difference between seed offsets, so growing the budget is safe but
// an offset reaching the stride is not. Residues mod 977: candidates 0, decor 889, rounding 945.
#define UNIVERSE_SLOT_STRIDE 977
#define UNIVERSE_DECOR_OFFSET 24337
#define UNIVERSE_ROUND_OFFSET 51749

// A four-input hash: the field's CellHash is keyed on the cell alone, while placement wants many draws per cell,
// so the slot must be a real input. Cast to uint BEFORE multiplying -- signed overflow is UB in C++ and a
// compiler that proves it happens may fold the expression to a constant.
float4 UniverseKeyHash4(int InA, int InB, int InC, int InD)
{
    uint ua = (uint) InA;
    uint ub = (uint) InB;
    uint uc = (uint) InC;
    uint ud = (uint) InD;

    // MIXED SEQUENTIALLY, ONE INPUT AT A TIME, not the parallel form the field's CellHash uses. v ^ -v depends
    // only on v's trailing zero count and every multiplier is odd, so flipping two axes sharing a count cancels
    // the XOR deltas and a cell hashes IDENTICALLY to its mirror, giving mirror-symmetric gaps at the grid's own
    // frequency. THE FIELD'S HASH IS SAFE AND THIS ONE IS NOT: WrapCell reduces field indices into [0, period),
    // while this key is the signed, unwrapped TIER GRID COORD. A MULTIPLY AND A SHIFT AFTER EVERY TERM fixes it.
    uint n = 2166136261u;

    n ^= ua * 73856093u;
    n *= 2246822519u;
    n ^= n >> 15u;

    n ^= ub * 19349663u;
    n *= 2246822519u;
    n ^= n >> 15u;

    n ^= uc * 83492791u;
    n *= 2246822519u;
    n ^= n >> 15u;

    n ^= ud * 2654435761u;
    n *= 2246822519u;
    n ^= n >> 15u;

    // Two LCG rounds per component, not the field's bit-mask decode: an acceptance draw wants more than the 256
    // levels a byte slice gives, or the accepted fraction quantises and sparse regions round to nothing.
    uint a = n * 1664525u + 1013904223u;
    uint b = a * 1664525u + 1013904223u;
    uint c = b * 1664525u + 1013904223u;
    uint d = c * 1664525u + 1013904223u;

    const float Inv = 1.0f / 4294967296.0f;

    return float4((float) a * Inv, (float) b * Inv, (float) c * Inv, (float) d * Inv);
}

// PowSafe as a free function: the placement path holds no params instance. Guards the BASE only, since
// pow(0, p) is undefined for p <= 0; the exponent stays unguarded so a negative one blows up visibly.
float UniversePowSafe(float x, float p)
{
    return (x > UNIVERSE_POW_EPSILON) ? pow(x, p) : 0.0f;
}

struct UniversePlacement // PER DISPATCH, not per field: two tiers place different entities against one field
{
    // The density reading as a certain spawn, inverted. PER CELL rather than per dispatch: each cell rejects
    // against ITS OWN probed peak, so the ratio runs order-1, most candidates land, and the cell cancels out.
    float InvDensityReference;

    float SpawnExponent; // 1 is the raw response; below 1 spawns more in faint regions
    float ExtentMin; // FINAL units: divide by UnitScale before filling this in
    float ExtentMax;
    float ExtentExponent; // below 1 biases small, above 1 biases large
};

UniversePlacement MakeUniversePlacement(
    float InDensityReference, // the density that reads as a certain spawn
    float InSpawnExponent,
    float InExtentMin, // FINAL units: divide by UnitScale before calling
    float InExtentMax,
    float InExtentExponent)
{
    UniversePlacement Q;

    Q.InvDensityReference = 1.0f / max(InDensityReference, 1e-3f); // a division guard: zero accepts everything
    Q.SpawnExponent = max(InSpawnExponent, 1e-3f);
    Q.ExtentMin = InExtentMin;
    Q.ExtentMax = InExtentMax;
    Q.ExtentExponent = max(InExtentExponent, 1e-3f);

    return Q;
}

struct UniverseCandidate // before the field has been consulted
{
    float3 Pos; // caller's units
    float3 Norm; // the same point in the field's normalized frame
    float AcceptDraw; // uniform in [0,1), compared against the spawn probability
    float ExtentDraw; // uniform in [0,1), decorrelated from AcceptDraw
    float3 Decor;
};

struct UniverseEntity
{
    float3 Pos; // caller's units, the same frame as the cell centre passed in
    float Extent;
    float Density; // raw field value at Pos, before any spawn shaping
    float3 Decor; // three decorrelated uniforms in [0,1) for colour, rotation, type
    float bValid; // 0 = rejected; the caller skips it
};

// The largest value the field can return anywhere, from its authored ranges alone. the wall term saturate(N-1)
// raised to a positive exponent and the filament term saturate(N-2), both capping at 1, so the composition
// bounds at the three resolved maxima. Loose -- NOT A REPLACEMENT FOR PROBING, but a CORRECTNESS CHECK.
float UniverseAnalyticCeiling(UniverseDensityParams P)
{
    float wallMax = max(P.WallDensityRange.x, P.WallDensityRange.y);
    float filamentMax = max(P.FilamentDensityRange.x, P.FilamentDensityRange.y);
    float floorMax = max(P.VoidFloorRange.x, P.VoidFloorRange.y);

    return max(wallMax, 0.0f) + max(filamentMax, 0.0f) + max(floorMax, 0.0f);
}

// A sample point inside a cell, for estimating its density ENVELOPE before any candidate is drawn. EIGHT CORNERS
// THEN JITTER, since corners alone miss a filament crossing a cell's middle and jitter alone misses a peak on a
// vertex. The jitter key runs DOWNWARD from the cell seed, candidates upward, so the two families never meet.
float3 MakeUniverseProbe(float3 InCellCentre, float InCellExtent,
                         int InCellX, int InCellY, int InCellZ,
                         int InKeySeed, uint InProbeIndex)
{
    if (InProbeIndex < 8u)
    {
        return float3(
            InCellCentre.x + ((InProbeIndex & 1u) != 0u ? InCellExtent : -InCellExtent),
            InCellCentre.y + ((InProbeIndex & 2u) != 0u ? InCellExtent : -InCellExtent),
            InCellCentre.z + ((InProbeIndex & 4u) != 0u ? InCellExtent : -InCellExtent));
    }

    float4 h = UniverseKeyHash4(InCellX, InCellY, InCellZ,
                                InKeySeed - (int) (InProbeIndex + 1u) * UNIVERSE_SLOT_STRIDE);

    return float3(
        InCellCentre.x + (h.x * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.y + (h.y * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.z + (h.z * 2.0f - 1.0f) * InCellExtent);
}

// Three decorrelated uniforms in [0,1) in one 32-bit word, ten bits each -- halves the entity record, and 1024
// levels per channel is past what a colour target carries. THE WORD MUST STAY IN AN INTEGER BUFFER: read as a
// float an arbitrary pattern can land on a denormal or a NaN. SCALAR ONLY, per the parity subset.
uint PackUniverseDecor(float3 InDecor)
{
    uint qx = (uint) (saturate(InDecor.x) * 1023.0f + 0.5f);
    uint qy = (uint) (saturate(InDecor.y) * 1023.0f + 0.5f);
    uint qz = (uint) (saturate(InDecor.z) * 1023.0f + 0.5f);

    return qx | (qy << 10u) | (qz << 20u);
}

float3 UnpackUniverseDecor(uint InPacked)
{
    const float Inv = 1.0f / 1023.0f;

    return float3(
        (float) (InPacked & 1023u) * Inv,
        (float) ((InPacked >> 10u) & 1023u) * Inv,
        (float) ((InPacked >> 20u) & 1023u) * Inv);
}

// How many candidates a cell draws, from a real-valued budget. STOCHASTIC, NOT ROUNDED OR FLOORED: most of a
// cosmic web is void, so deterministic rounding destroys the bottom end -- a floor of 1 makes void population
// track CELL COUNT rather than density, plain rounding empties everything below half a candidate, and both show
// as a cubic lattice on a cubic grid. Adding one with probability frac() has expectation exactly InRaw, and the
// cell-only key makes the count WAVE-UNIFORM so the strided candidate loop cannot diverge.
uint UniverseStochasticCount(float InRaw, int InCellX, int InCellY, int InCellZ,
                             int InKeySeed, float InCeiling)
{
    float r = min(max(InRaw, 0.0f), InCeiling);

    float whole = floor(r); // the fraction is NOT named `frac`; shadowing an HLSL intrinsic is not portable
    float fracPart = r - whole;

    float4 h = UniverseKeyHash4(InCellX, InCellY, InCellZ, InKeySeed + UNIVERSE_ROUND_OFFSET);

    return (uint) whole + ((h.x < fracPart) ? 1u : 0u);
}

// The probability a candidate survives, against the cell's own envelope. The ratio is order-1 because the
// reference IS that cell's probed peak, so the accepted fraction stays high enough not to waste the budget.
float UniverseSpawnProbability(float InDensity, UniversePlacement InPlace)
{
    float ratio = saturate(max(InDensity, 0.0f) * InPlace.InvDensityReference);

    return saturate(UniversePowSafe(ratio, max(InPlace.SpawnExponent, 1e-3f)));
}

// One candidate, decided entirely by its own key. InInvFieldExtent converts the caller's units to the field's
// normalized frame, passed in rather than stored here where it could disagree with the proxy's. NOTE WHAT IS
// ABSENT: the field offset, a property of the VIEW -- the field is static in caller space, so magnitudes stay
// small here.
UniverseCandidate MakeUniverseCandidate(float3 InCellCentre, float InCellExtent,
                                        float InInvFieldExtent, int InCellX, int InCellY,
                                        int InCellZ, int InSlot)
{
    UniverseCandidate C;

    float4 h = UniverseKeyHash4(InCellX, InCellY, InCellZ, InSlot);

    C.Pos = float3(
        InCellCentre.x + (h.x * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.y + (h.y * 2.0f - 1.0f) * InCellExtent,
        InCellCentre.z + (h.z * 2.0f - 1.0f) * InCellExtent);

    C.Norm = float3(C.Pos.x * InInvFieldExtent,
                    C.Pos.y * InInvFieldExtent,
                    C.Pos.z * InInvFieldExtent);

    C.AcceptDraw = h.w;

    // MUST NOT REUSE AcceptDraw or share a component with it: acceptance keeps only draws below p, so sharing it
    // correlates extent with density and leaves the voids holding tiny entities -- field galaxies all dwarfs.
    float e = h.x * 7.31f + h.y * 3.17f + h.z * 11.71f;
    C.ExtentDraw = e - floor(e);

    // A second key: colour stays stable per entity without being tied to where it landed.
    float4 g = UniverseKeyHash4(InCellX, InCellY, InCellZ, InSlot + UNIVERSE_DECOR_OFFSET);
    C.Decor = float3(g.x, g.y, g.z);

    return C;
}

// InDensity is the RAW value at C.Norm. IT MUST BE THE UNFADED VALUE -- UniverseRayMarch applies BoundsFade and
// SampleAtPosition does not -- or where an entity lands depends on where the player stood at generation.
UniverseEntity FinishUniverseEntity(UniversePlacement InPlace, UniverseCandidate InC,
                                    float InDensity)
{
    UniverseEntity E;

    E.Pos = InC.Pos;
    E.Density = InDensity;
    E.Decor = InC.Decor;
    E.bValid = (InC.AcceptDraw < UniverseSpawnProbability(InDensity, InPlace))
        ? 1.0f : 0.0f;

    E.Extent = InPlace.ExtentMin
        + (InPlace.ExtentMax - InPlace.ExtentMin)
          * UniversePowSafe(InC.ExtentDraw, max(InPlace.ExtentExponent, 1e-3f));

    return E;
}
