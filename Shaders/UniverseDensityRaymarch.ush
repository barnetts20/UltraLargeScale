#pragma once

// UniverseDensityRaymarch.ush
// The ray march, and nothing else: step sizing, accumulation, early-out, and one SampleAtPosition call per step.
// Everything touching a texture lives in UniverseDensityCore.ush; the four texture pairs are held here but never
// read, and nothing touches Parameters or View. THE ONLY CALLER IS A MATERIAL Custom node, which includes this by
// path and fails at SHADER compile rather than at build. The field offset never passes through here: constant for
// the draw, it is resolved once into the params struct, still split into integer cell and fraction, since a
// float3 holding the player's position loses the fraction far too early.

#include "/UltraLargeScale/UniverseDensityCore.ush"

// --- RAYMARCH: ANALYTIC SPHERE-BOUNDED DENSITY ACCUMULATION ---
// Same rule as the galaxy layer: baseStep = chord / StepCount, then h = baseStep * (1 + StepGrowth * t01), t01
// being progress along the chord and NOT distance from the camera -- which goes to ZERO at the camera, and a
// viewer inside the volume is the normal case here, so successive samples landed in one cell each paying a
// fifty-four-candidate walk to re-derive an unchanged field. STEPCOUNT IS A BUDGET, NOT A COUNT: growth
// overshoots the chord early, giving StepCount * ln(1 + growth) / growth steps. DO NOT ADD A BOX BOUNDS TEST --
// InStartPos sits exactly on the proxy surface, so one breaks on iteration zero wherever rounding pushes it out.
// InViewVec is the local camera vector, surface toward camera, DIRECTION ONLY; InCamPosN is the camera in
// NORMALIZED space, the marched position's frame, NO REMAP applied here. Returns (emission, raw step count, 0,
// transmittance) -- the count rides in G because a truncated march looks identical to a finished one.
float4 UniverseRayMarch(UniverseDensityParams P,
                        Texture3D InVarianceTexA, SamplerState InVarianceSamplerA,
                        Texture3D InVarianceTexB, SamplerState InVarianceSamplerB,
                        Texture3DSigned InWarpTexLarge, SamplerState InWarpSamplerLarge,
                        Texture3DSigned InWarpTexSmall, SamplerState InWarpSamplerSmall,
                        float3 InStartPos, float3 InViewVec, float3 InCamPosN,
                        float InStepGrowth, float InMinStep, float InStepCount,
                        int InMaxSteps, float InDensityScale, float InJitter,
                        float InNoisePower)
{
    float3 o = 2.0 * (InStartPos - 0.5); // unit box [0,1] -> normalized [-1,1]; uniform, so dir is unchanged
    float3 dir = normalize(-InViewVec);

    float b = dot(o, dir);
    float c = dot(o, o) - 1.0;
    float disc = b * b - c;
    if (disc <= 0.0)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    float sq = sqrt(disc);

    // WILL CHANGE: the proxy becomes a sphere centred on the CAMERA, collapsing this to a fixed span. Inside,
    // clamp the near end; outside take the whole chord WITHOUT clamping to zero, since an inverted-normal proxy
    // shades the FAR face and its chord lies at negative t.
    float tEnter = (c < 0.0) ? 0.0 : (-b - sq);
    float tExit = -b + sq;
    if (tExit <= tEnter)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    float dCam = dot(o - InCamPosN, dir);

    // START AT THE CAMERA WHEN INSIDE: the step is a fraction of the span, so an untrimmed stretch behind the
    // viewer coarsens everything visible as well as wasting budget. GUARDED TO ONLY EVER SHORTEN.
    float tStart = tEnter;
    if (dCam > 0.0 && -dCam > tEnter && -dCam < tExit)
    {
        tStart = -dCam;
    }

    float span = max(tExit - tStart, 1e-6);
    float baseStep = span / max(InStepCount, 1.0);

    // Two floors answering different questions: the pin is how far a step MAY go, P.MinFeatureStep how much
    // detail is there to find (UNIVERSE_MIN_STEP_FRACTION). The pin alone is ignorant of cell size.
    float minStep = max(max(InMinStep, P.MinFeatureStep), 1e-5);

    float growth = max(InStepGrowth, 0.0);
    float invSpan = 1.0 / span;

    float firstScale = clamp(InJitter, 0.05, 1.0); // shortens the FIRST step; no path lost, the exit clamps

    float t = tStart;
    float stepsTaken = 0.0;

    bool bShape = (InNoisePower != 1.0);

    float transmittance = 1.0;
    float emission = 0.0;

    [loop]
    for (int i = 0; i < InMaxSteps; i++) // InMaxSteps is a SAFETY BOUND, not the count; keep it above StepCount
    {
        if (t >= tExit)
        {
            break;
        }

        stepsTaken += 1.0;

        float t01 = saturate((t - tStart) * invSpan); // saturated: tStart past tExit would go negative
        float h = max(baseStep * (1.0 + growth * t01), minStep);

        if (i == 0)
        {
            h *= firstScale;
        }

        if (t + h > tExit)
        {
            h = tExit - t;
        }

        // MIDPOINT, which is why sizing precedes the fetch: growing steps otherwise weight every interval by its
        // LEADING FACE, a systematic bias toward the camera rather than noise.
        float3 samplePos = o + dir * (t + h * 0.5);

        float density = P.SampleAtPosition(InVarianceTexA, InVarianceSamplerA,
                                           InVarianceTexB, InVarianceSamplerB,
                                           InWarpTexLarge, InWarpSamplerLarge,
                                           InWarpTexSmall, InWarpSamplerSmall,
                                           samplePos);
        if (bShape)
        {
            density = P.PowSafe(density, InNoisePower);
        }

        // APPLIED HERE, not in the field: the fade belongs to how the field is VIEWED, and entity generation
        // samples the same core and must see none of it.
        density *= P.BoundsFade(dot(samplePos, samplePos));

        float alpha = 1.0 - exp(-density * InDensityScale * h * 0.5);

        emission += alpha * transmittance; // flat white: structure only
        transmittance *= 1.0 - alpha;

        if (transmittance < 0.001)
        {
            break;
        }

        t += h;
    }

    return float4(emission, stepsTaken, 0.0, transmittance);
}
