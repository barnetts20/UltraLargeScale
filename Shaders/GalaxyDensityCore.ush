#pragma once

// UniverseDensity.ush
// The ray march, and the noise modulation that rides on it. The domain warp used to
// live here in spirit -- everything touching a texture did -- but the core now takes
// a Texture3D directly and warps inside the ranking, so this file's job has narrowed
// to marching the volume and multiplying the web by a detail field.
//
// The texture and sampler are threaded down into the core rather than sampled here.
// The warp has to happen BEFORE the neighbourhood search, on the cell-and-fraction
// split, and there is no way to hand a warped position across this boundary without
// reconstructing a float3 -- which stops resolving a fraction of a cell long before
// the magnitudes this layer reaches.
//
// The proxy for this layer is pegged to the camera, so it never moves through the
// field -- the FIELD SCROLLS UNDER IT. That offset is threaded through every entry
// point below rather than being folded into the sample position on the way in,
// because it arrives already split into an integer cell count and a fraction and has
// to stay split: a float3 carrying the player's position stops resolving a fraction
// of a cell long before the magnitudes this layer reaches.
//
// Nothing here touches Parameters or View -- those exist only inside the generated
// material function, so the dither that needs them stays in the Custom node body.

#include "/UltraLargeScale/UniverseDensityCore.ush"

// Channels are centred to [-1,1] BEFORE weighting, so a weight acts as a mixer:
// positive takes the channel, negative inverts it, |w| > 1 is gain. Ridging happens
// per channel for the same reason it does in the galaxy -- the 1-2|c| fold only maps
// back into [-1,1] when its input is already bounded there.
float UniverseSampleNoiseTex(UniverseDensityParams P, Texture3D InTex,
                             SamplerState InSampler, float3 Pos)
{
    float4 t = InTex.SampleLevel(InSampler, Pos, 0);
    float4 c = t * 2.0 - 1.0;

    c = lerp(c, 1.0 - 2.0 * abs(c), P.NoiseRidged);

    return dot(P.NoiseChannelWeights, c);
}

float UniverseFBm(UniverseDensityParams P, Texture3D InTex, SamplerState InSampler, float3 Pos)
{
    float sum = 0.0;
    float amp = 1.0;

    for (int o = 0; o < UNIVERSE_MAX_OCTAVES; o++)
    {
        if (o >= P.NoiseOctaveCount)
        {
            break;
        }

        // A texture has no seed, so octaves decorrelate by offset.
        sum += UniverseSampleNoiseTex(P, InTex, InSampler,
                                      Pos + float3(17.3, 11.7, 23.1) * float(o)) * amp;
        Pos *= UNIVERSE_NOISE_LACUNARITY;
        amp *= UNIVERSE_NOISE_GAIN;
    }

    return sum * P.InvNoiseNorm;
}

// Analytic web, then modulation.
//
// Gated on the web being non-zero, as in the galaxy: most of the volume is void, so
// the gate skips the fetch for the majority of march steps. The void floor makes
// "non-zero" almost everywhere though, so the threshold is against the floor rather
// than against zero -- otherwise the gate never fires and costs a comparison for
// nothing.
//
// The noise coordinate is still built by reconstructing a float3 and wrapping the
// cell offset at 512. The warp no longer does this -- it masks the integer cell and
// converts only the remainder, which is exact at any magnitude -- and the same
// treatment is the obvious next thing to give the noise, which would remove the 512
// wrap along with the precision floor underneath it.
//
// The noise coordinate scrolls with the field. If it did not, the texture detail
// would sit still in the proxy while the web moved through it, which reads as the
// structure sliding under a fixed layer of grain. It scrolls on the cell offset
// WRAPPED to a few hundred cells: a texture coordinate has no precision left at the
// full offset anyway, and the noise is decorrelated well within the wrap distance,
// so the repeat is not reachable in a single view.
// Returns density. The second component used to be the distance in CELL units the
// march could skip without
// being able to miss a feature. The noise never touches y: it is gated on the web
// already being above the floor, so in the skippable span the density is exactly
// VoidFloor and integrates in closed form over any step length.
float UniverseSample(UniverseDensityParams P, Texture3D InTex, SamplerState InSampler,
                     Texture3D InWarpTex, SamplerState InWarpSampler,
                     float3 NormPos, float3 OffsetCell, float3 OffsetFrac)
{
    float d = P.SampleAtPosition(InTex, InSampler, InWarpTex, InWarpSampler,
                                 NormPos, OffsetCell, OffsetFrac);

#if UNIVERSE_COST_PROBE >= 1
    bool bNoise = false;   // probe level 1: detail fBm removed at compile time
#else
    bool bNoise = (P.NoiseEnable > 0.5) && (P.NoiseAmount != 0.0);
#endif
    if (bNoise && d > P.VoidFloor * 1.001)
    {
        float3 wrapped = fmod(OffsetCell, 512.0) + OffsetFrac;
        float3 scrolled = NormPos + wrapped / max(P.InvCellSize, 1e-6);

        float3 nf = scrolled * P.NoiseScaleLateral + P.NoiseOffset;
        nf.z = scrolled.z * P.NoiseScaleVertical + P.NoiseOffset.z;

        float n = UniverseFBm(P, InTex, InSampler, nf);
        d *= max(1.0 + P.NoiseAmount * n, 0.0);
    }

    return d;
}

// --- RAYMARCH: ANALYTIC SPHERE-BOUNDED DENSITY ACCUMULATION ---
// Same stepping rule as the galaxy layer. The proxy mesh decides which pixels run; the
// unit sphere decides where to march.
//
// STEP LENGTH IS A FRACTION OF CAMERA DISTANCE, so every step subtends about the same
// angle and covers about the same screen area wherever it is. The recurrence
// s -> s(1 + StepRatio) is geometric, which makes the step count LOGARITHMIC in range
// rather than linear -- against a fixed count spread evenly along the chord, that is the
// difference between a budget spent mostly where nothing is visible and one spent where
// the pixels are.
//
// It is now the ONLY thing setting step length. It used to set a floor that an
// empty-space skip could override wherever the skip was larger; that skip has been
// removed. The two answered different questions --
// how much detail a step needs, and how much detail is there.
//
// Do not add a box bounds test on the marched position. InStartPos sits exactly on
// the proxy surface, so a component is exactly 0 or 1 before any FP error, and such a
// test breaks on iteration zero wherever rounding pushes it outside -- view-direction
// dependent, so it shows as angle-dependent dropout at silhouettes.
//
// WILL CHANGE: the universe proxy is a sphere centred on the CAMERA, so the chord is
// a constant length and the entry/exit maths collapses to a fixed span rather than an
// intersection. Correct as written for a fixed test volume; not the final bounding.
//
// InViewVec is the LOCAL camera vector, surface toward camera. DIRECTION ONLY.
//
// InCamPosN is the camera in NORMALIZED space -- the same frame as the marched position,
// box spanning -1 to 1 -- and no remap is applied to it here. A remap applied in the
// shader silently biases anything supplied in a different frame, and a biased camera
// position is indistinguishable from a correct one until the geometry is wrong.
//
// Once the proxy becomes a sphere centred on the camera this collapses: the camera is
// always at the origin, InCamPosN is zero, and the distance is just t.
//
// RETURNS  (emission, steps taken, 0, transmittance).
//
// The step count rides in G because cost has no other observer: a march that truncates
// looks identical to one that finished, and the far half of the volume is simply absent.
float4 UniverseRayMarch(UniverseDensityParams P, Texture3D InTex, SamplerState InSampler,
                        Texture3D InWarpTex, SamplerState InWarpSampler,
                        float3 InStartPos, float3 InViewVec, float3 InCamPosN,
                        float3 InOffsetCell, float3 InOffsetFrac,
                        float InStepRatio, float InMinStep, float InMinSamples,
                        int InMaxSteps, float InDensityScale, float InJitter,
                        float InNoisePower)
{
    // Unit box [0,1] -> normalized space [-1,1]. Uniform scale, so a direction is
    // identical in both.
    float3 o = 2.0 * (InStartPos - 0.5);
    float3 dir = normalize(-InViewVec);

    float b = dot(o, dir);
    float c = dot(o, o) - 1.0;
    float disc = b * b - c;
    if (disc <= 0.0)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    float sq = sqrt(disc);

    // Origin inside the sphere: clamp the near end. Outside: take the whole chord
    // WITHOUT clamping to zero, because with an inverted-normal proxy the shaded
    // point is the far face and the chord lies at negative t.
    float tEnter = (c < 0.0) ? 0.0 : (-b - sq);
    float tExit = -b + sq;
    if (tExit <= tEnter)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    // DISTANCE FROM THE CAMERA, which is what sets step size. The sample at t sits at
    // o + dir*t and the camera at o - dCam*dir, so their separation is (dCam + t).
    float dCam = dot(o - InCamPosN, dir);

    // START AT THE CAMERA WHEN IT IS INSIDE THE VOLUME. The chord otherwise begins
    // behind the viewer, and every step of that stretch runs at the floor because the
    // separation there is zero -- the whole budget spent on geometry nobody can see.
    //
    // GUARDED SO IT CAN ONLY SHORTEN. Each condition rules out a way a wrong InCamPosN
    // could empty the chord instead of trimming it; the fallback is the full chord,
    // which is slower but still correct.
    float tStart = tEnter;
    if (dCam > 0.0 && -dCam > tEnter && -dCam < tExit)
    {
        tStart = -dCam;
    }

    float k = max(InStepRatio, 0.0);
    float minStep = max(InMinStep, 1e-5);

    // FLOOR ON SAMPLES ACROSS THE CHORD. Angular sizing says how much detail a step
    // needs and nothing about how much the volume has; past some range one step spans
    // the whole thing and the structure disappears rather than softening.
    float maxStep = (tExit - tStart) / max(InMinSamples, 1.0);

    // Dither shortens the FIRST step. It costs no path length -- the loop clamps the
    // last step to the exit -- and it offsets each pixel's lattice independently.
    float firstScale = clamp(InJitter, 0.05, 1.0);

    float t = tStart;
    float stepsTaken = 0.0;

    bool bShape = (InNoisePower != 1.0);

    // Cell units to normalized units.
    float transmittance = 1.0;
    float emission = 0.0;

    // InMaxSteps is a SAFETY BOUND, not the step count. The geometric progression sets
    // the count; this only stops a pathological ratio from hanging the shader.
    [loop]
    for (int i = 0; i < InMaxSteps; i++)
    {
        if (t >= tExit)
        {
            break;
        }

        stepsTaken += 1.0;

        // SAMPLED AT THE STEP START, not the midpoint. The galaxy march samples the
        // midpoint because growing steps otherwise weight each interval by its leading
        // face. That reason is now the only one left -- the empty-space skip used to
        // anchor a bound at the sampled point, and it is gone -- so moving to the
        // midpoint is available if the leading-face bias ever proves worse than the
        // half-step offset.
        float density = UniverseSample(P, InTex, InSampler, InWarpTex, InWarpSampler,
                                       o + dir * t, InOffsetCell, InOffsetFrac);
        if (bShape)
        {
            density = P.PowSafe(density, InNoisePower);
        }

        // max against zero, not just against the floor: a sample behind the camera has
        // a negative separation, and without it a wrong camera position gives negative
        // step lengths and a march that never terminates.
        float h = max(minStep, max(dCam + t, 0.0) * k);
        h = min(h, maxStep);

        // FIRST-STEP DITHER. Without it every ray starts at the same place and takes
        // identical steps, so sample positions lock to the field across every pixel at
        // once -- structured aliasing that swims as the field scrolls under the proxy.
        //
        // No path is lost: the clamp below pulls the last step to the exit, so every
        // ray covers the same span whatever its offset.
        if (i == 0)
        {
            h *= firstScale;
        }

        if (t + h > tExit)
        {
            h = tExit - t;
        }

        // The 0.5 is a bare CONSTANT here, not a unit conversion: the universe layers
        // author raw amplitudes against a void floor and have no path-length
        // normalisation to pair with, so it is folded into their tuning. It is not the
        // galaxy's factor and does not move with it.
        float alpha = 1.0 - exp(-density * InDensityScale * h * 0.5);

        // Flat white emission: structure only.
        emission += alpha * transmittance;
        transmittance *= 1.0 - alpha;

        if (transmittance < 0.001)
        {
            break;
        }

        t += h;
    }

    return float4(emission, stepsTaken, 0.0, transmittance);
}
