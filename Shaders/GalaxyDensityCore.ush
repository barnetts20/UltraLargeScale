#pragma once

// GalaxyDensityCore.ush
// The galaxy density field: analytic layers, texture sampling, composition.
//
// NEVER BINDS A RESOURCE, ONLY RECEIVES ONE. Every sampling function takes the texture and sampler its caller
// already holds; nothing here declares one or touches Parameters or View, which is what lets a material Custom
// node and a compute dispatch call the same code.
//
// GPU ONLY: a C++ path would stub every texture fetch to a neutral and so evaluate the ANALYTIC field alone, a
// plausible galaxy that ignores what the material draws, so it must never place entities. Included by
// GalaxyPlacement.ush (lattice, candidates, probes, count, ceiling) and GalaxyDensityRaymarch.ush.
//
// PARITY RULES -- both compilers must accept this file, so: guard every pow() base away from zero (HLSL
// evaluates pow as exp2(y*log2(x)), and log2(0) is -INF); bound anything that can overflow float32 (exp
// overflows near 88 on GPU against 709 for double on CPU); use no swizzle beyond .x/.y/.z/.w and no intrinsic a
// small C++ shim could not define. VECTOR FORMS ARE THE TRAP -- uint3, a vector saturate or float3 * float
// compile cleanly as HLSL and fail on the C++ side alone, where nothing routine catches it.
//
// SPACE: normalized galaxy space, [-1,1] per axis, where 1.0 is Params.Extent.
// LAYER CONVENTION: x = arms, y = disc, z = bulge, w = background -- SampleLayers' return and every
//   per-layer float4 input.
// FRAME CONVENTION, NoiseScale and WarpScale ONLY: x = disc lateral, y = disc vertical, z = halo lateral,
//   w = halo vertical.
//
// DERIVED STATE: every field arrives pre-clamped and, where a division by it would recur, pre-inverted.
// MakeGalaxyDensityParams is the ONLY place that derives them. Do not re-clamp in the sample functions, which
// run per march step behind early-returns the compiler cannot hoist past.

#define GALAXY_PI 3.14159265358979323846f
#define GALAXY_POW_EPSILON 1e-6f
#define GALAXY_MAX_ARMS 16

// Marks the two SIGNED resources apart from the two UNORM ones at the signature: warp fetches read curl/gradient
// assets already in [-1,1], modulation fetches read UNORM multinoise. An alias, not a check -- both resolve to
// Texture3D -- and the decode is written out at each fetch site.
#define Texture3DSigned Texture3D

// The march's step floor, as a fraction of the field's finest feature. Derived in MakeGalaxyDensityParams from
// the two THIN things the field can express: the arm cross-section (ArmWidth, squashed further by a vertical
// ratio below 1) and the disc scale height at the centre. Both are HALF-thicknesses, so this multiplies -- and
// HALF because accumulation is exact for constant density over a step, so half a half-thickness puts two samples
// inside every arm and finer buys nothing. THE NOISE IS DELIBERATELY NOT IN THIS: NoiseScale gives a period, but
// the features inside one period belong to the baked texture, so a period-based floor would be an ORDER coarser
// and therefore binding. ONLY EVER LENGTHENS A STEP.
#define GALAXY_MIN_STEP_FRACTION 0.5f

struct GalaxyDensityParams
{
    float BoundsFadeStart;
    float BoundsFadeStartSq;
    float InvBoundsFadeSpan;

    // --- MARCH --- not read in this file: derived here because this is where the layer thicknesses live, and
    // handed to GalaxyRayMarch as its step floor. See GALAXY_MIN_STEP_FRACTION.
    float MinFeatureStep; // normalized units; the step below which sampling is wasted

    // --- BULGE ---
    float BulgeInvRadiusSq; // 1 / r^2 at which the layer reaches exactly zero
    float BulgeDensityOverPath; // optical depth through the centre / path length
    float BulgeInvSquash; // 1 / (c/a axis ratio); larger flattens
    float BulgeConcentration; // profile exponent; see SampleSpheroid

    // --- DISC ---
    float DiscRadius;
    float InvDiscRadius;
    float DiscHeightRatio; // h/R at the centre
    float DiscDensityOverPath; // face-on optical depth / the profile integral
    float InvDiscScaleL; // 1 / radial scale length
    float DiscVerticalFalloff; // profile exponent, same meaning as concentration
    float DiscFlare; // 0 = constant scale height; >0 thickens outward
    float DiscWarpAmplitude; // m=1 vertical warp, normalized z units
    float DiscWarpPhase; // radians; azimuth of the rising node at r = 0
    float DiscWarpTwist; // radians of node-line precession across the disc
    float DiscLopsidedAmount; // m=1 in-plane density mode; 0.2-0.4 typical
    float DiscLopsidedPhase; // radians; azimuth of the dense side

    // --- GLOBAL ORIENTATION --- rows of the INVERSE (transposed) basis: a sample crosses into field space by
    // three dots. Identity at zero angles.
    float3 FieldX;
    float3 FieldY;
    float3 FieldZ;

    // Galaxy space -> field space. THE ONE PLACE orientation is applied, called at the top of both sample entry
    // points so nothing downstream knows it exists. A rotation is an isometry, so dot(p,p) is unchanged and
    // every bounds test keeps working. It must stay here rather than on the actor transform, which would rotate
    // the octree, the tier grids and VirtualTraversal out from under a galaxy-local-equals-world assumption.
    float3 ToFieldSpace(float3 InPos)
    {
        return float3(dot(FieldX, InPos), dot(FieldY, InPos), dot(FieldZ, InPos));
    }

    // --- ARMS ---
    float ArmSpiralK0; // signed 1/tan(pitch); sign sets chirality
    float ArmPitchFactorMax; // 1 + |ArmAsymPitch|; bounds the angular reject
    float ArmPitchTightening; // 0 = constant pitch; >0 tightens inward
    float ArmWidth; // true perpendicular half-width at the inner end
    float InvArmVerticalRatio; // 1 / (H/W). H/W of 1 is a circular tube
    float ArmProfileExponent; // cross-section falloff. <1 plateaus, >1 sharpens
    float ArmRadialGrowth; // width multiplier at the rim
    float ArmHostFalloff; // how strongly arms inherit the disc radial profile
    float ArmDensityOverPath; // perpendicular optical depth / path length
    float InvArmFadeW; // 1 / width of the per-arm end fade
    int ArmN;
    float4 ArmData[GALAXY_MAX_ARMS]; // x pitch factor, y phase, z strength,
                                     // w radius at which the end fade STARTS

    // --- BACKGROUND ---
    float BackgroundInvRadiusSq;
    float BackgroundDensityOverPath;
    float BackgroundInvSquash;
    float BackgroundConcentration;

    // --- CENTRAL VOID ---
    float InvVoidRadiusSq;
    float VoidStrength; // 0 = off, 1 = fully empty at the centre
    float VoidConcentration;

    // --- PER-LAYER NOISE RESPONSE --- multiplicative depth: density *= 1 + Amount * n. Above 1 the modulator
    // goes negative, clamps to zero and breaks the layer apart. Signed warp amounts flip the direction.
    float NoiseAmountArm;
    float NoiseAmountDisc;
    float NoiseAmountBulge;
    float NoiseAmountBackground;
    float WarpAmountArms;
    float WarpAmountDisc;
    float WarpAmountBulge;
    float WarpAmountBackground;

    // --- NOISE FIELD SHAPE --- consumed by the texture-sampling field below, carried here so the set travels as
    // one value. Ridging is a property of WHICH ASSET is bound, not a uniform.
    float3 NoiseOffset; // varies which region of an asset a galaxy reads; a texture has no seed
    float4 NoiseScale; // modulation frequency, frame convention
    float4 WarpScale; // warp frequency, frame convention
    float4 NoiseChannelWeights; // signed channel mix
    float NoiseEnable; // 0 skips every texture read
    float HaloTwistInherit; // fraction of the spiral twist the halo frame takes

    // SpawnExponent, extent range and extent shaping are PER TIER and live in GalaxyPlacement.ush: this
    // derivation runs sixteen arm hashes and a tan, so rebuilding it per tier would repeat all of that to alter
    // two numbers the field never reads.

    // ============================================== HELPERS ==============================================

    // pow() with the zero base branched out rather than clamped: max(x, EPSILON) still leaves EPSILON^p behind,
    // which is enough to floor a field.
    float PowSafe(float x, float p)
    {
        return (x > GALAXY_POW_EPSILON) ? pow(x, p) : 0.0f;
    }

    // Integral of (1 - x^2)^c over [-1,1]. Exactly B(1/2, c+1); this closed form is within 1.4% at c = 0.25 and
    // under 0.5% above c = 1. Derivation-only.
    float CompactProfileIntegral(float InConcentration)
    {
        return sqrt(GALAXY_PI / (max(InConcentration, 0.0f) + 0.75f));
    }

    // Integer hash, one float4 per arm index. uint arithmetic wraps identically in C++ and HLSL, so this is
    // bit-exact across both. Derivation-only.
    float4 ArmHash(int InIndex, int InSeed)
    {
        // CAST TO uint BEFORE MULTIPLYING, reached at the SHIPPED DEFAULT: the seed term crosses int32 at 111
        // and the default is 211. Signed overflow is UB in C++, so a compiler that proves it happens may fold
        // the expression away and the arms come out with NO asymmetry. Suffix multipliers with u.
        uint n = ((uint) InIndex * 73856093u) ^ ((uint) InSeed * 19349663u);

        // Scalar rather than uint4: an integer vector falls outside the parity subset.
        uint a = n * 1664525u + 1013904223u;
        uint b = a * 1664525u + 1013904223u;
        uint c = b * 1664525u + 1013904223u;
        uint d = c * 1664525u + 1013904223u;

        a ^= a >> 16u;
        b ^= b >> 16u;
        c ^= c >> 16u;
        d ^= d >> 16u;
        a *= 1664525u;
        b *= 1664525u;
        c *= 1664525u;
        d *= 1664525u;
        a ^= a >> 16u;
        b ^= b >> 16u;
        c ^= c >> 16u;
        d ^= d >> 16u;

        const float Inv32 = 1.0f / 4294967296.0f;
        return float4(float(a) * Inv32, float(b) * Inv32,
                      float(c) * Inv32, float(d) * Inv32);
    }

    // =============================================== LAYERS ===============================================

    // Disc radial profile, shared with the arms. Truncated by edge = 1 - rn^2 so it reaches zero at the rim
    // rather than being cut there. The caller passes edge because both call sites already have it.
    float DiscRadialProfile(float rXY, float edge)
    {
        return exp(-rXY * InvDiscScaleL) * edge;
    }

    // --- COMBINED ARM DENSITY --- every arm contributes and the contributions are merged. Do not switch to a
    // nearest-arm search: its distance is continuous but the WINNER'S attributes flip instantly where two arms
    // are equidistant, so per-arm strength variation gives a hard density step. Affordable per arm because the
    // closest point lies at the SAME RADIUS as the query, making the in-plane distance the chord subtending the
    // angular offset, 2 r sin(d/2). Cross-section is a normalized ellipse: both offsets are divided by their own
    // half-extent into one coordinate q reaching 1 at the surface, and one metric on one profile makes the arm
    // tubular.
    float SampleArmDensity(float3 InNormPos, float rXY)
    {
        if (rXY < 1e-6f || rXY >= DiscRadius)
        {
            return 0.0f;
        }

        // The guard above bounds rXY to (0, DiscRadius), so no saturate is needed.
        float tRadial = rXY * InvDiscRadius;
        float edge = 1.0f - tRadial * tRadial;

        // Arms take the SAME sqrt(edge) lens taper as the disc. Without it the disc closes to zero at the rim
        // while the arm keeps widening at ArmRadialGrowth, so past rn ~ 0.85 the arms bulge outside the disc as
        // a thick collar -- which ArmHostFalloff dims but cannot thin.
        float growthFactor = lerp(1.0f, ArmRadialGrowth, tRadial) * sqrt(edge);
        float invW = 1.0f / max(ArmWidth * growthFactor, 1e-6f);

        // Exact vertical gate: q >= qz always and the surface is q = 1, so qz >= 1 proves every arm is zero
        // here, skipping the merge loop for the majority of samples. H = W * ratio, so its reciprocal comes from
        // invW rather than a second divide.
        float qz = abs(InNormPos.z) * invW * InvArmVerticalRatio;
        if (qz >= 1.0f)
        {
            return 0.0f;
        }
        float qzSq = qz * qz;

        // Arms are a compression wave in the disc, so their strength follows the disc hosting them. Evaluated
        // before the loop so a negligible host skips it.
        float host = PowSafe(DiscRadialProfile(rXY, edge), ArmHostFalloff);
        if (host <= 0.0f)
        {
            return 0.0f;
        }

        // Logarithmic spiral: tan(p) = dr/(r dTheta) integrates to Theta = ln(r/R)/tan(p), so the winding rate
        // grows as 1/r inward and ln() is self-bounding. ArmPitchTightening adds k(u) = k0(1 + Tu), so Theta
        // becomes k0(u + Tu^2/2); -log(tRadial) avoids a second divide.
        float u = -log(max(tRadial, 1e-5f));
        float T = ArmPitchTightening;
        float uTerm = u + 0.5f * T * u * u;
        float uRate = 1.0f + T * u;

        float theta = atan2(InNormPos.y, InNormPos.x);

        const float TwoPi = 2.0f * GALAXY_PI;
        const float InvTwoPi = 1.0f / TwoPi;

        // --- ANGULAR EARLY REJECT --- dPerp = 2 r |sin(d/2)| * corr, and corr = rsqrt(1 + kLocal^2) is at least
        // corrMin, taken at the largest kLocal any arm can have here, so an arm whose |d| exceeds this threshold
        // cannot reach within W. DEPENDS ON ArmPitchFactorMax covering every arm's pitch factor: if the per-arm
        // pitch model ever exceeds it, arms DISAPPEAR rather than merely running slow.
        float kMax = abs(ArmSpiralK0) * ArmPitchFactorMax * uRate;
        float corrMin = rsqrt(1.0f + kMax * kMax);
        float sinHalf = 1.0f / max(2.0f * rXY * corrMin * invW, 1e-6f);
        float dReject = (sinHalf >= 1.0f) ? GALAXY_PI : 2.0f * asin(sinHalf);

        float acc = 0.0f;

        for (int i = 0; i < GALAXY_MAX_ARMS; i++)
        {
            if (i >= ArmN)
            {
                break;
            }

            float4 a = ArmData[i];
            float ki = ArmSpiralK0 * a.x;

            // Signed angular offset, wrapped to [-PI,PI]. Wrapping to +/-PI rather than +/-armSpacing/2 is what
            // makes uneven arm spacing safe.
            float dRaw = theta - (ki * uTerm + a.y);
            float d = dRaw - TwoPi * round(dRaw * InvTwoPi);

            if (abs(d) >= dReject)
            {
                continue;
            }

            // The chord is purely tangential and the spiral tangent makes angle p with it, so perpendicular
            // distance is chord / sqrt(1+k^2). Unconditional, so ArmWidth is a true perpendicular half-width
            // that does not shift with the pitch angle.
            float kLocal = ki * uRate;
            float dPerp = 2.0f * rXY * abs(sin(0.5f * d)) * rsqrt(1.0f + kLocal * kLocal);

            float qp = dPerp * invW;
            float q = sqrt(qp * qp + qzSq);
            if (q >= 1.0f)
            {
                continue;
            }

            float w = 1.0f - q * q * (3.0f - 2.0f * q);

            // a.w is the radius at which the end fade STARTS, folded in the derivation.
            float mult = a.z;
            if (rXY > a.w)
            {
                float tf = saturate((rXY - a.w) * InvArmFadeW);
                mult *= 1.0f - tf * tf * (3.0f - 2.0f * tf);
            }

            // Plain max: a.z is clamped in the derivation and the fade is a saturated smoothstep.
            acc = max(acc, w * mult);
        }

        // Shape applied once to the merged result, so it stays a single pow.
        acc = PowSafe(acc, ArmProfileExponent);

        return acc * ArmDensityOverPath * host;
    }

    // --- COMPACT SQUASHED SPHEROID, SHARED BY BULGE AND BACKGROUND ---
    //     d = InDensityOverPath * (1 - x^2)^p,   x^2 = r_oblate^2 * InInvRadiusSq
    // Compact support: exactly zero at x >= 1, so the layer terminates itself and the test is a free early-out.
    // Works on r^2, so no sqrt. p < 1 fills the volume and drops at the rim; 1 parabolic; 2 smooth bump;
    // >2 concentrates. Do not swap for a cusped profile such as Hernquist: it diverges at the centre, and the
    // clamp keeping it finite turns the peak parameter into a saturated-ball radius.
    float SampleSpheroid(float3 InNormPos, float InDensityOverPath, float InInvRadiusSq,
                         float InInvSquash, float InConcentration)
    {
        if (InDensityOverPath <= 0.0f)
        {
            return 0.0f;
        }

        float squashedZ = InNormPos.z * InInvSquash;

        float rSq = InNormPos.x * InNormPos.x
                  + InNormPos.y * InNormPos.y
                  + squashedZ * squashedZ;

        float x2 = rSq * InInvRadiusSq;
        if (x2 >= 1.0f)
        {
            return 0.0f;
        }

        return InDensityOverPath * PowSafe(1.0f - x2, InConcentration);
    }

    // --- DISC, LENS CROSS-SECTION --- radial exp(-r/scaleLength) x vertical (1 - (z/h)^2)^falloff, h tapering
    // to zero at the rim. All three terms are compact for a reason: an exponential vertical profile sits at
    // 0.368 of peak where it is cut and the radial one at 0.135, so both produce cliffs, and without the
    // sqrt(1-rn^2) taper the cross-section reads as a machined cylinder. DiscDensityOverPath divides by the
    // LOCAL h -- volume density is surface density over thickness, and the h cancels from the face-on integral
    // exactly.
    float SampleDiscDensity(float rXY, float absZ)
    {
        if (DiscDensityOverPath <= 0.0f)
        {
            return 0.0f;
        }
        if (rXY >= DiscRadius)
        {
            return 0.0f;
        }

        float rn = rXY * InvDiscRadius;
        float edge = 1.0f - rn * rn;

        float h = DiscRadius * DiscHeightRatio * (1.0f + DiscFlare * rn) * sqrt(edge);
        if (absZ >= h)
        {
            return 0.0f;
        }

        // One reciprocal: h divides both the vertical coordinate and the density.
        float invH = 1.0f / h;

        float zNorm = absZ * invH;
        float verticalProfile = PowSafe(1.0f - zNorm * zNorm, DiscVerticalFalloff);

        return DiscDensityOverPath * invH * DiscRadialProfile(rXY, edge) * verticalProfile;
    }

    // ============================================ COMPOSITION ============================================

    // Region cleared by the central black hole; a multiplier in [1 - VoidStrength, 1]. Spherical rather than
    // squashed: what accretion clears is not set by disc rotation.
    float VoidFactor(float rBoundsSq)
    {
        if (VoidStrength <= 0.0f)
        {
            return 1.0f;
        }

        float x2 = rBoundsSq * InvVoidRadiusSq;
        if (x2 >= 1.0f)
        {
            return 1.0f;
        }

        return 1.0f - VoidStrength * PowSafe(1.0f - x2, VoidConcentration);
    }

    float BoundsFade(float rBoundsSq)
    {
        if (rBoundsSq <= BoundsFadeStartSq)
        {
            return 1.0f;
        }

        float t = (sqrt(rBoundsSq) - BoundsFadeStart) * InvBoundsFadeSpan;
        return 1.0f - t * t * (3.0f - 2.0f * t);
    }

    // THE LOUDEST LAYER WINS, and this is what makes LayerDensity mean what it says. The four layers are four
    // descriptions of one stellar population at different scales, not four media in one volume, so summing would
    // double-count: a bulge of 3 over a disc of 0.5 would draw 3.5 through the core. Under max each pin IS that
    // layer's peak, so ArmDensity = 1 draws as 1. THE COST is that a dimmer layer is INVISIBLE where a brighter
    // one overlaps -- raising a pin takes a region over rather than brightening it -- and max is C0 but not C1,
    // creasing the gradient along every layer crossing. Not clamped: the marcher wants the range.
    float Compose(float4 L, float rBoundsSq)
    {
        float Density = max(max(max(L.x, L.y), L.z), L.w);

        Density *= VoidFactor(rBoundsSq);
        Density *= BoundsFade(rBoundsSq);

        return Density;
    }

    // Returns (arm, disc, bulge, background), unmodulated -- no composition, no bounds fade. InGasWarp and
    // InHaloWarp are RAW displacement vectors centred on zero; per-layer amounts are applied here, so the caller
    // samples the warp field once per family. Zero = unwarped.
    float4 SampleLayersWarped(float3 InNormPos, float3 InGasWarp, float3 InHaloWarp)
    {
        float3 armPos = InNormPos + InGasWarp * WarpAmountArms;
        float3 discPos = InNormPos + InGasWarp * WarpAmountDisc;
        float3 bulgePos = InNormPos + InHaloWarp * WarpAmountBulge;
        float3 bgPos = InNormPos + InHaloWarp * WarpAmountBackground;

        // --- GALAXY-SCALE m=1 MODES --- From the UNWARPED position and shared by both gas layers: these belong
        // to the galaxy, not a layer, and per-layer derivation would let positional warp rotate the lopsided
        // axis differently for arms and disc. The warp ramps as rn^2 because the bulge holds the inner disc
        // rigid, which is also why the bulge does not warp; lopsidedness ramps as rn to avoid an azimuthal seam
        // on the axis.
        float lopsided = 1.0f;
        if (DiscWarpAmplitude != 0.0f || DiscLopsidedAmount != 0.0f)
        {
            float rXY0 = sqrt(InNormPos.x * InNormPos.x + InNormPos.y * InNormPos.y);
            float rn0 = saturate(rXY0 * InvDiscRadius);
            float theta0 = atan2(InNormPos.y, InNormPos.x);

            float warpZ = DiscWarpAmplitude * rn0 * rn0
                        * sin(theta0 - DiscWarpPhase - DiscWarpTwist * rn0);

            lopsided = max(1.0f + DiscLopsidedAmount * rn0
                               * cos(theta0 - DiscLopsidedPhase), 0.0f);

            armPos.z -= warpZ;
            discPos.z -= warpZ;
        }

        // Gated on its own density, as every layer is: zeroing a LayerDensity component both removes the layer
        // and skips its cost.
        float ArmDensity = 0.0f;
        if (ArmDensityOverPath > 0.0f)
        {
            float rXYArm = sqrt(armPos.x * armPos.x + armPos.y * armPos.y);
            ArmDensity = SampleArmDensity(armPos, rXYArm) * lopsided;
        }

        float rXYDisc = sqrt(discPos.x * discPos.x + discPos.y * discPos.y);
        float DiscDensity = SampleDiscDensity(rXYDisc, abs(discPos.z)) * lopsided;

        float BulgeDensity = SampleSpheroid(bulgePos, BulgeDensityOverPath,
                                            BulgeInvRadiusSq, BulgeInvSquash,
                                            BulgeConcentration);

        float BgDensity = SampleSpheroid(bgPos, BackgroundDensityOverPath,
                                         BackgroundInvRadiusSq, BackgroundInvSquash,
                                         BackgroundConcentration);

        return float4(ArmDensity, DiscDensity, BulgeDensity, BgDensity);
    }

    // Applies the two noise families to the four layers. Zero for either value leaves its layers untouched,
    // which is how the caller says "the gate rejected this family".
    float4 ApplyModulation(float4 L, float InGasNoise, float InHaloNoise)
    {
        L.x *= max(1.0f + NoiseAmountArm * InGasNoise, 0.0f);
        L.y *= max(1.0f + NoiseAmountDisc * InGasNoise, 0.0f);
        L.z *= max(1.0f + NoiseAmountBulge * InHaloNoise, 0.0f);
        L.w *= max(1.0f + NoiseAmountBackground * InHaloNoise, 0.0f);
        return L;
    }

    // The analytic field with no noise at all; what the shader produces at NoiseEnable = 0.
    float SampleAnalytic(float3 InNormPos)
    {
        // Squared, so out-of-bounds samples never pay for the sqrt. BEFORE the rotation, which cannot change it,
        // so those samples skip the basis transform too.
        float rBoundsSq = dot(InNormPos, InNormPos);
        if (rBoundsSq >= 1.0f)
        {
            return 0.0f;
        }

        float3 FieldPos = ToFieldSpace(InNormPos);

        float3 Zero = float3(0.0f, 0.0f, 0.0f);
        return Compose(SampleLayersWarped(FieldPos, Zero, Zero), rBoundsSq);
    }

    // ======================================================================
    // NOISE FRAME -- shapes the domain the noise is sampled in. Reads no texture, but it is the section to
    // alter when changing how noise relates to the geometry.
    // ======================================================================

    // Rotating a sample by -twist before evaluating noise makes features wind with the spiral and shear inward.
    // InInherit scales it; 1 is the full gas twist. InU is min(-log(rn), 6) and InRn is rXY/discR, both from the
    // caller, since the two twists share a radius. THE r/R RAMP IS LOAD BEARING: raw twist grows as ln(R/r),
    // reaching 11 radians at r = 0.05R and smearing halo noise into streaks; ramping peaks it near 0.37R.
    float SpiralTwistAt(float InU, float InRn, float InInherit)
    {
        if (InInherit == 0.0f)
        {
            return 0.0f;
        }

        float T = ArmPitchTightening;
        return ArmSpiralK0 * (InU + 0.5f * T * InU * InU) * InRn * InInherit;
    }

    // InScale is (lateral, vertical). Vertical above lateral compresses z, so features read as sheets. InOffset
    // separates the two frames' domains.
    float3 NoiseFrame(float3 InPos, float InTwist, float2 InScale, float3 InOffset)
    {
        float st, ct;
        sincos(InTwist, st, ct);

        return float3((InPos.x * ct + InPos.y * st) * InScale.x,
                     (-InPos.x * st + InPos.y * ct) * InScale.x,
                       InPos.z * InScale.y) + InOffset;
    }
};

// ==========================================================================
// DERIVATION -- the single place clamping, inversion and per-arm hashing happen. CALLED POSITIONALLY by the
// material's Custom node, which fails at SHADER compile rather than at build. ONLY EVER APPEND to this
// argument list: inserting or removing one silently shifts every pin after it.
// ==========================================================================
GalaxyDensityParams MakeGalaxyDensityParams(
    float4 InLateralScale, // x arm width, y disc radius,
                                    // z bulge radius, w background radius
    float4 InVerticalScale, // per-layer axis ratios, same order
    float4 InLayerDensity, // per-layer OPTICAL DEPTH, same order
    float4 InNoiseAmount, // per-layer modulation depth, same order
    float4 InWarpAmount, // per-layer warp amount, signed, same order
    float4 InArmAsym, // x pitch, y phase, z density, w length
    float4 InSpiralTwist, // x pitch deg, y tightening,
                                    // z phase offset, w halo inherit
    float3 InCentralVoid, // x radius, y strength, z concentration
    float4 InNoiseScale, // frame convention
    float4 InWarpScale, // frame convention
    float4 InNoiseChannelWeights,
    float3 InNoiseOffset,
    float InBoundsFadeStart,
    float InDiscScaleLengthRatio, // multiple of the bulge radius
    float InDiscVerticalFalloff,
    float InDiscFlare,
    float InDiscWarpAmplitude,
    float InDiscWarpPhase,
    float InDiscWarpTwist,
    float InDiscLopsidedAmount,
    float InDiscLopsidedPhase,
    float InArmCount,
    float InArmAsymSeed,
    float InArmProfileExponent,
    float InArmRadialGrowth,
    float InArmHostFalloff,
    float InBulgeConcentration,
    float InBackgroundConcentration,
    float InNoiseEnable,
    float4 InFieldOrientation) // xyz disc normal in GALAXY space, w spin in DEGREES
{
    GalaxyDensityParams P;

    // --- GLOBAL ORIENTATION --- A NORMAL AND A SPIN, not Euler angles: the universe layer already produces a
    // uniform unit vector per particle for sprite orientation, so the galaxy inherits it with NO CONVERSION, and
    // a normal pins the disc plane directly. The rows are the basis TRANSPOSE, its inverse for an orthonormal
    // one, because samples travel galaxy -> field while the normal describes field -> galaxy.
    {
        // COMPONENTWISE, AND NORMALIZED BY HAND: the parity subset has neither swizzles nor normalize, though
        // dot and rsqrt are in it.
        float3 Raw = float3(InFieldOrientation.x, InFieldOrientation.y, InFieldOrientation.z);
        float LenSq = dot(Raw, Raw);

        // A ZERO NORMAL IS REACHABLE -- an unset FVector3f, or a rolled range bracketing the origin. rsqrt(0)
        // would poison the basis and hand back a galaxy of NaNs.
        float3 N = (LenSq > 1e-12f)
            ? (Raw * rsqrt(LenSq))
            : float3(0.0f, 0.0f, 1.0f);

        // Duff et al. branchless orthonormal basis. BRANCHLESS MATTERS AT THE POLE: the usual
        // cross-with-an-arbitrary-axis construction degenerates there; the sign trick keeps N.z = -1 finite.
        float s = (N.z >= 0.0f) ? 1.0f : -1.0f;
        float a = -1.0f / (s + N.z);
        float b = N.x * N.y * a;

        float3 T = float3(1.0f + s * N.x * N.x * a, s * b, -s * N.x);
        float3 B = float3(b, s + N.y * N.y * a, -N.y);

        float sn, cs;
        sincos(InFieldOrientation.w * 0.01745329252f, sn, cs);

        P.FieldX = cs * T + sn * B;
        P.FieldY = cs * B - sn * T;
        P.FieldZ = N;
    }

    P.BoundsFadeStart = InBoundsFadeStart;
    P.BoundsFadeStartSq = InBoundsFadeStart * InBoundsFadeStart;
    P.InvBoundsFadeSpan = 1.0f / max(1.0f - InBoundsFadeStart, 1e-6f);

    // --- LATERAL AND VERTICAL SCALES ---
    // Every layer is a body with a lateral scale S and a vertical extent S * V; the four vertical controls are
    // all axis ratios and smaller flattens. LateralScale.y does double duty, the disc radius also being the arm
    // system's radial reference. CORRELATED INPUTS are resolved here, not in the material graph:
    //   arm width      is a fraction of the disc's scale height
    //   bulge radius   is a fraction of the disc radius
    //   void radius    is a fraction of the disc radius
    //   arm growth     is a coefficient on the disc's flare
    P.DiscHeightRatio = max(InVerticalScale.y, 1e-6f);
    P.DiscRadius = max(InLateralScale.y, 1e-6f);
    P.InvDiscRadius = 1.0f / P.DiscRadius;
    P.ArmWidth = max(InLateralScale.x * P.DiscHeightRatio, 1e-6f);

    // See GALAXY_MIN_STEP_FRACTION. The arm's narrowest axis is its half-width times the vertical ratio when
    // that ratio is below 1 and unsquashed otherwise -- min against 1 rather than the raw ratio, since a ratio
    // above 1 makes the arm a vertical ribbon whose WIDTH is then the thin axis.
    {
        float armThin = P.ArmWidth * min(1.0f, max(InVerticalScale.x, 1e-4f));
        float discHalfHeight = P.DiscRadius * P.DiscHeightRatio;
        P.MinFeatureStep = GALAXY_MIN_STEP_FRACTION * min(armThin, discHalfHeight);
    }

    float bulgeR = max(InLateralScale.z * P.DiscRadius, 1e-6f);
    float bgR = max(InLateralScale.w, 1e-6f);

    P.InvArmVerticalRatio = 1.0f / max(InVerticalScale.x, 1e-4f);
    P.BulgeInvSquash = 1.0f / max(InVerticalScale.z, 1e-3f);
    P.BackgroundInvSquash = 1.0f / max(InVerticalScale.w, 1e-3f);

    P.BulgeInvRadiusSq = 1.0f / (bulgeR * bulgeR);
    P.BackgroundInvRadiusSq = 1.0f / (bgR * bgR);

    // From the bulge rather than the disc radius: the bulge-to-disc scale ratio is a real measured quantity,
    // while the disc radius is just where the disc is truncated.
    P.InvDiscScaleL = 1.0f / max(bulgeR * max(InDiscScaleLengthRatio, 1e-6f), 1e-6f);

    // --- PROFILE EXPONENTS ---
    P.BulgeConcentration = max(InBulgeConcentration, GALAXY_POW_EPSILON);
    P.BackgroundConcentration = max(InBackgroundConcentration, GALAXY_POW_EPSILON);
    P.DiscVerticalFalloff = max(InDiscVerticalFalloff, 0.1f);
    P.ArmProfileExponent = max(InArmProfileExponent, GALAXY_POW_EPSILON);
    P.ArmRadialGrowth = InArmRadialGrowth * InDiscFlare;
    P.ArmHostFalloff = max(InArmHostFalloff, 0.0f);

    // --- DISC ASYMMETRY ---
    P.DiscFlare = max(InDiscFlare, 0.0f);
    P.DiscWarpAmplitude = InDiscWarpAmplitude;
    P.DiscWarpPhase = InDiscWarpPhase;
    P.DiscWarpTwist = InDiscWarpTwist;
    P.DiscLopsidedAmount = InDiscLopsidedAmount;
    P.DiscLopsidedPhase = InDiscLopsidedPhase;

    // --- SPIRAL ---
    float pitchDeg = clamp(InSpiralTwist.x, -89.0f, 89.0f);
    float tanP = tan(radians(max(abs(pitchDeg), 1.0f)));
    P.ArmSpiralK0 = ((pitchDeg < 0.0f) ? -1.0f : 1.0f) / tanP;
    P.ArmPitchTightening = max(InSpiralTwist.y, 0.0f);
    P.HaloTwistInherit = InSpiralTwist.w;
    P.ArmPitchFactorMax = 1.0f + abs(InArmAsym.x);

    // --- CENTRAL VOID ---
    float voidR = max(InCentralVoid.x * P.DiscRadius, 1e-6f);
    P.InvVoidRadiusSq = 1.0f / (voidR * voidR);
    P.VoidStrength = saturate(InCentralVoid.y);
    P.VoidConcentration = max(InCentralVoid.z, GALAXY_POW_EPSILON);

    // --- PER-LAYER NOISE RESPONSE ---
    P.NoiseAmountArm = InNoiseAmount.x;
    P.NoiseAmountDisc = InNoiseAmount.y;
    P.NoiseAmountBulge = InNoiseAmount.z;
    P.NoiseAmountBackground = InNoiseAmount.w;

    P.WarpAmountArms = InWarpAmount.x;
    P.WarpAmountDisc = InWarpAmount.y;
    P.WarpAmountBulge = InWarpAmount.z;
    P.WarpAmountBackground = InWarpAmount.w;

    // --- NOISE FIELD ---
    P.NoiseOffset = InNoiseOffset;
    P.NoiseScale = max(InNoiseScale, 1e-6f);
    P.WarpScale = max(InWarpScale, 1e-6f);
    P.NoiseChannelWeights = InNoiseChannelWeights;
    P.NoiseEnable = InNoiseEnable;

    // --- OPTICAL DEPTH NORMALISATION --- LayerDensity is an OPTICAL DEPTH per layer, not a density: what you
    // would measure looking through that layer along its natural axis. Dividing by the layer's own path length
    // makes the four comparable, independent of step count, and readable as the number the marcher accumulates.
    // The divisor is the FULL integral of that layer's profile, so the marcher is a plain sum. All four divisors
    // and that accumulation are ONE CONVENTION: change any and every authored brightness shifts.
    P.ArmDensityOverPath = InLayerDensity.x / P.ArmWidth;

    P.DiscDensityOverPath = InLayerDensity.y
        / max(P.CompactProfileIntegral(P.DiscVerticalFalloff), 1e-6f);

    P.BulgeDensityOverPath = InLayerDensity.z
        / max(bulgeR * P.CompactProfileIntegral(P.BulgeConcentration), 1e-6f);

    P.BackgroundDensityOverPath = InLayerDensity.w
        / max(bgR * P.CompactProfileIntegral(P.BackgroundConcentration), 1e-6f);

    // --- PER-ARM RECORDS --- invariant along a ray, so hashing per sample would repeat identical work. Every
    // slot is filled, not just the first ArmN, so none is read uninitialised.
    //
    // ArmData.w IS A FADE START, AND IT CAN GO NEGATIVE. At an ArmAsymLength near 1 a high hash draw puts the
    // start at -armFadeW, so the fade is complete at r = 0 and that arm is DELETED rather than shortened while
    // ArmN still reads what was authored. Unclamped; worth knowing before a missing arm is blamed on the loop.
    P.ArmN = (int) clamp(InArmCount, 1.0f, (float) GALAXY_MAX_ARMS);

    float armFadeW = max(0.2f * P.DiscRadius, 1e-6f);
    P.InvArmFadeW = 1.0f / armFadeW;

    float armSpacing = 2.0f * GALAXY_PI / float(P.ArmN);
    int armSeed = (int) InArmAsymSeed;

    for (int ai = 0; ai < GALAXY_MAX_ARMS; ai++)
    {
        float4 h = P.ArmHash(ai, armSeed);

        P.ArmData[ai] = float4(
            1.0f + InArmAsym.x * (2.0f * h.x - 1.0f),
            InSpiralTwist.z + float(ai) * armSpacing
                + InArmAsym.y * armSpacing * (2.0f * h.y - 1.0f),
            max(1.0f + InArmAsym.z * (2.0f * h.z - 1.0f), 0.0f),
            P.DiscRadius * (1.0f - InArmAsym.w * h.w) - armFadeW);
    }

    return P;
}

// ===========================================================================
// TEXTURE-SAMPLING FIELD
//
// FOUR TEXTURES, FOUR FETCHES, split BY FAMILY as well as by role:
//   WarpTexDisc     disc warp        signed vector field   displaces arms and disc
//   WarpTexHalo     halo warp        signed vector field   displaces bulge and background
//   NoiseTexDisc    disc modulation  UNORM multinoise      lanes and filament in the disc
//   NoiseTexHalo    halo modulation  UNORM multinoise      grain in the bulge and halo
//
// DISC AND HALO IN THE PIN NAMES, gas and halo in the locals below, deliberately: a pin's job is to say which
// LAYERS it reaches, while inside the field the distinction really is gas versus halo. SPLIT BY FAMILY, NOT
// ONLY BY ROLE, because gas lanes want ridged, filamentary, Worley-leaning structure while the halo wants
// something smooth and low-frequency, so one asset could only be a compromise. ASSET CHOICE carries that, and
// is also how ridging is selected -- there is no ridging uniform. Each fetch having its own asset, none needs
// a domain offset; NoiseOffset varies which region of an asset a GALAXY reads, which is what gives two
// galaxies on one archetype different noise.
// ===========================================================================

// --- THE MODULATION FETCH --- ONE FETCH. The texture already carries a spectrum, so summing octaves of it
// re-filters something already filtered, at one read each, in a dynamic loop, on the hottest path in the stack;
// for more fractal detail bake a deeper field into a larger volume. SampleLevel, not Sample, because inside a
// dynamic loop the derivatives driving mip selection are undefined -- and called as a method rather than through
// Texture3DSampleLevel so this file does not depend on Common.ush preceding it.
//
// Channels are centred to [-1,1] BEFORE weighting, which lets a weight act as a mixer: positive takes the
// channel, negative inverts it, |w| > 1 is gain, all-zero returns 0. Output is NOT bounded to [-1,1], since
// sum|w| > 1 exceeds it, and the modulator is 1 + Amount * n, so large |n| spikes density as well as clamping it
// to zero; keep sum|w| near 1 unless gain is wanted. EXPECTS A MULTINOISE ASSET -- four uncorrelated generators,
// one per channel. Fed four channels of one packed Perlin-Worley volume the mixer blends four VIEWS of one
// field: values decorrelate but structure does not, so NoiseChannelWeights does far less than it looks.
float GalaxySampleNoiseTex(GalaxyDensityParams P, Texture3D InNoiseTex, SamplerState InNoiseSampler, float3 Pos)
{
    float4 t = InNoiseTex.SampleLevel(InNoiseSampler, Pos, 0);

    float cx = t.x * 2.0f - 1.0f;
    float cy = t.y * 2.0f - 1.0f;
    float cz = t.z * 2.0f - 1.0f;
    float cw = t.w * 2.0f - 1.0f;

    return dot(P.NoiseChannelWeights, float4(cx, cy, cz, cw));
}

// Full field: analytic layers, positionally warped, then modulated. The ORDER matters for cost -- warp must be
// sampled before the layers because it displaces the position they are evaluated at, but modulation is sampled
// AFTER, gated on the layers being non-zero, and most of the volume is empty. FOUR PAIRS spelled out rather than
// hidden behind a macro, since which asset reaches which fetch is the entire content of the texture split. The
// warp pair is Texture3DSigned and the modulation pair Texture3D, so a C++ compiler catches a swap between the
// two ROLES -- though not one between gas and halo within a role, since those share a type.
float GalaxySample(GalaxyDensityParams P,
                   Texture3DSigned InWarpTexDisc, SamplerState InWarpSamplerDisc,
                   Texture3DSigned InWarpTexHalo, SamplerState InWarpSamplerHalo,
                   Texture3D InNoiseTexDisc, SamplerState InNoiseSamplerDisc,
                   Texture3D InNoiseTexHalo, SamplerState InNoiseSamplerHalo,
                   float3 InSamplePos)
{
    // Squared, so out-of-bounds samples never pay for the sqrt. BEFORE the rotation, which cannot change it, so
    // those samples skip the basis transform too.
    float rBoundsSq = dot(InSamplePos, InSamplePos);
    if (rBoundsSq >= 1.0f)
    {
        return 0.0f;
    }

    // GALAXY SPACE -> FIELD SPACE, once, here. Everything below -- layers, noise frame, warp lookup, the m=1
    // modes -- works in field space and is unaware the galaxy is oriented.
    float3 NormPos = P.ToFieldSpace(InSamplePos);

    bool bNoise = P.NoiseEnable > 0.5f;

    // Split so neither twist is built when nothing consumes it.
    bool bGasNoise = bNoise && (P.WarpAmountArms != 0.0f || P.WarpAmountDisc != 0.0f
                              || P.NoiseAmountArm != 0.0f || P.NoiseAmountDisc != 0.0f);
    bool bHaloNoise = bNoise && (P.WarpAmountBulge != 0.0f || P.WarpAmountBackground != 0.0f
                              || P.NoiseAmountBulge != 0.0f || P.NoiseAmountBackground != 0.0f);

    float gasTwist = 0.0f;
    float haloTwist = 0.0f;

    if (bGasNoise || bHaloNoise)
    {
        // One log for both twists: they share this radius.
        float rXY0 = sqrt(NormPos.x * NormPos.x + NormPos.y * NormPos.y);
        float rn0 = saturate(rXY0 * P.InvDiscRadius);
        float u0 = min(-log(max(rn0, 1e-5f)), 6.0f);

        gasTwist = bGasNoise ? P.SpiralTwistAt(u0, rn0, 1.0f) : 0.0f;
        haloTwist = bHaloNoise ? P.SpiralTwistAt(u0, rn0, P.HaloTwistInherit) : 0.0f;
    }

    // One fetch per family, not an FBm call: warp wants a single low frequency and RGB supplies a
    // three-component vector directly. The two layers in a family share the fetch and scale it independently, so
    // they can warp in opposite directions for one lookup.
    //
    // NO CENTRING STEP -- these read purpose-baked curl and gradient volumes, which ARE signed, and THE DECODED
    // RANGE IS THE AMOUNT'S DENOMINATOR: [-1,+1] displaces twice as far as the same amount against a centred
    // UNORM decode, so GalaxyParams.h's defaults assume signed assets. AN UNSIGNED ASSET BOUND HERE has a mean
    // of +0.5 read as signed, so the family is bodily TRANSLATED by half its warp amount rather than locally
    // displaced -- a disc that still looks like a disc, just not concentric with the bulge.
    float3 gasWarp = float3(0.0f, 0.0f, 0.0f);
    float3 haloWarp = float3(0.0f, 0.0f, 0.0f);

    if (bGasNoise && (P.WarpAmountArms != 0.0f || P.WarpAmountDisc != 0.0f))
    {
        float3 wf = P.NoiseFrame(NormPos, gasTwist, float2(P.WarpScale.x, P.WarpScale.y), P.NoiseOffset);
        float4 ws = InWarpTexDisc.SampleLevel(InWarpSamplerDisc, wf, 0);
        gasWarp = float3(ws.x, ws.y, ws.z);
    }

    // From the ORIGINAL position, not a gas-warped one, so the two displacements stay independent rather than
    // compounding.
    if (bHaloNoise && (P.WarpAmountBulge != 0.0f || P.WarpAmountBackground != 0.0f))
    {
        float3 hf = P.NoiseFrame(NormPos, haloTwist, float2(P.WarpScale.z, P.WarpScale.w),
                                 P.NoiseOffset);
        float4 hs = InWarpTexHalo.SampleLevel(InWarpSamplerHalo, hf, 0);
        haloWarp = float3(hs.x, hs.y, hs.z);
    }

    float4 L = P.SampleLayersWarped(NormPos, gasWarp, haloWarp);

    // Sampled at the UNWARPED position: one fetch feeds two layers warped differently, so either warped position
    // would be arbitrary. != 0.0 rather than > 0.0, so a negative amount -- a valid inversion of the modulation
    // -- is not silently dropped.
    float gasNoise = 0.0f;
    float haloNoise = 0.0f;

    if (bGasNoise && (P.NoiseAmountArm != 0.0f || P.NoiseAmountDisc != 0.0f)
        && (L.x + L.y) > 1e-4f)
    {
        float3 nf = P.NoiseFrame(NormPos, gasTwist, float2(P.NoiseScale.x, P.NoiseScale.y), P.NoiseOffset);
        gasNoise = GalaxySampleNoiseTex(P, InNoiseTexDisc, InNoiseSamplerDisc, nf);
    }

    if (bHaloNoise && (P.NoiseAmountBulge != 0.0f || P.NoiseAmountBackground != 0.0f)
        && (L.z + L.w) > 1e-4f)
    {
        float3 hf = P.NoiseFrame(NormPos, haloTwist, float2(P.NoiseScale.z, P.NoiseScale.w),
                                 P.NoiseOffset);
        haloNoise = GalaxySampleNoiseTex(P, InNoiseTexHalo, InNoiseSamplerHalo, hf);
    }

    L = P.ApplyModulation(L, gasNoise, haloNoise);

    return P.Compose(L, rBoundsSq);
}
