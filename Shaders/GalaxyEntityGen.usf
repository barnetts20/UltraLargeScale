// GalaxyEntityGen.usf
// Entity placement on the GPU, so the generator sees the SAME field the material
// draws -- warp and modulation included.
//
// This is the point of the migration, and it is not only about parity. While
// placement could only run on the CPU the field had to stay resource-free, so every
// feature had to be paid for analytically. Reaching the volume texture from here
// means warp and detail can come from a fetch instead of from arithmetic, which
// changes what it is reasonable to write in the field at all.
//
// One thread per candidate. Placement is keyed on (cell, slot) and nothing is
// order-dependent, so a thread needs no neighbours and no group memory.

#include "/Engine/Public/Platform.ush"
#include "/UltraLargeScale/GalaxyDensity.ush"

// BISECT SWITCH. The standalone probe proved the module, shader path, parameter
// struct, UAV binding, dispatch and readback all work -- so the fault is in this
// shader, and it is either the BINDINGS (this struct has two UAVs, an SRV, a texture
// and forty loose parameters where the probe had one UAV) or the BODY.
//
// Set to 1 and MainCS does nothing but the marker write, with every parameter and
// buffer still declared and still bound:
//
//   marker PRESENT -> bindings are fine, something in the body stops execution.
//                     Re-enable and bisect the body: the density include, the cell
//                     fetch, MakeGalaxyDensityParams.
//   marker MISSING -> the bindings differ from the probe's in some way that matters.
//                     Remove parameters from the struct and the .usf together until
//                     it writes; the last one removed is the culprit.
//
// ANSWERED: with it at 1 the marker appeared and the parameters read back correctly
// (NumCells 1448, CandidateBudget 38, SlotStride 8), which cleared the bindings and
// left the dispatch itself -- a zero group count from a double-moved cell array.
// Kept because it costs nothing at 0 and is the fastest way to re-split "bindings"
// from "body" if this shader ever goes quiet again.
#define GALAXY_ENTITYGEN_PROBE_ONLY 0

// ---------------------------------------------------------------------------
// OUTPUT
//
// COMPACTED PER CELL, and every entity CARRIES ITS SLOT.
//
// The first version reserved one entry per candidate and let the CPU filter. That is
// correct and it does not scale: at nine thousand candidates a cell and acceptance
// around a third of a percent, the readback copies six and a half megabytes to
// extract a few hundred entities, with several batches in flight. The COPY, not the
// dispatch, is what was timing out.
//
// Compacting with a per-cell atomic makes the buffer SlotCapacity wide instead of
// CandidateBudget wide -- an order of magnitude less traffic.
//
// The reason an append buffer was rejected still stands: identity must be (cell,
// slot), not position in the output, or a region regenerates with its entities
// shuffled between visits. Writing Slot into each entity keeps that property while
// allowing the compaction. The ORDER within a cell is now nondeterministic; the SET,
// and every entity's identity within it, is not.
// ---------------------------------------------------------------------------
// A TYPED buffer of float4 triples, not a structured buffer of entities.
//
// The counters go through a typed RWBuffer and land; the entities went through a
// structured one and came back zeroed -- positions, extents and the sentinel all
// absent while the counters from the same dispatch were correct. Rather than keep
// guessing at why the structured path fails here, this uses the mechanism already
// proven to work in this pipeline.
//
// The layout is unchanged: three float4s are the same forty-eight bytes in the same
// order as the C++ mirror, so the readback still memcpys straight into it.
//   [0] Pos.xyz, Extent
//   [1] Decor.xyz, Density
//   [2] Slot, unused, unused, unused
RWBuffer<float4> OutEntities;
// TYPED, not structured. A structured buffer UAV has no format, and RDG's clear
// path needs one -- AddClearUAVPass over a structured UAV leaves the counters at
// whatever the allocator handed back. Uncleared, InterlockedAdd returns a huge index,
// every entity fails the bounds test below, and the cell writes nothing at all while
// looking entirely healthy.
// FOUR slots per cell, not one:
//   [0] accepted
//   [1] threads that reached the cell fetch
//   [2] the largest density any thread saw, as asuint
//   [3] the Candidates value the shader READ from the cell buffer
//
// Zero accepted is ambiguous on its own -- a dispatch that never ran, one that ran
// and saw an empty field, and one that ran on a healthy field and rejected everything
// all read the same from the CPU. These three separate them in a single readback.
// asuint is monotonic for non-negative floats, so InterlockedMax over the bit pattern
// orders exactly as the float does.
RWBuffer<uint> OutCounts;

// ---------------------------------------------------------------------------
// DISPATCH
//
// A batch of cells, each drawing CandidateBudget candidates. Cells are supplied as a
// buffer rather than derived from the thread id because the large tier's active set
// is sparse -- the prepass has already discarded cells with no structure in them, and
// re-deriving that on the GPU would repeat the whole cull.
// ---------------------------------------------------------------------------
struct FGalaxyGenCell
{
    float3 Centre; // caller's units
    float HalfExtent;
    int3 Coord; // the placement key; NOT the dispatch index
    float DensityReference; // per-cell envelope for the large tier, global otherwise
    uint Candidates; // this cell's own budget; threads past it return early
    uint3 Pad; // 48 bytes, so the C++ mirror needs no packing rules to match
};

StructuredBuffer<FGalaxyGenCell> InCells;

uint NumCells;
uint CandidateBudget; // the dispatch stride: the largest per-cell budget
uint SlotStride; // entries reserved per cell in OutEntities
int KeySeed; // galaxy seed folded with the tier's seed offset
float InvGalaxyExtent;

// --- placement, per dispatch; the per-cell reference overrides Q.InvDensityReference
float PlaceCompression;
float PlaceSpawnExponent;
float PlaceExtentMin;
float PlaceExtentMax;
float PlaceExtentExponent;

Texture3D NoiseTex;
SamplerState NoiseTexSampler;

// --- field parameters, raw, in the order MakeGalaxyDensityParams takes them -------
// Passed raw rather than as a pre-derived struct on purpose. A derived
// GalaxyDensityParams uploaded as a constant buffer would have to match HLSL's
// packing rules against the C++ layout member for member, and a single straddling
// float3 would silently shift everything after it. Deriving here costs sixteen arm
// hashes and a tan per thread against a full field evaluation, and it cannot drift.
float4 InLateralScale;
float4 InVerticalScale;
float4 InLayerDensity;
float4 InNoiseAmount;
float4 InWarpAmount;
float4 InArmAsym;
float4 InSpiralTwist;
float3 InCentralVoid;
float4 InNoiseScale;
float4 InWarpScale;
float4 InNoiseChannelWeights;
float3 InNoiseOffset;
float InBoundsFadeStart;
float InDiscScaleLengthRatio;
float InDiscVerticalFalloff;
float InDiscFlare;
float InDiscWarpAmplitude;
float InDiscWarpPhase;
float InDiscWarpTwist;
float InDiscLopsidedAmount;
float InDiscLopsidedPhase;
float InArmCount;
float InArmAsymSeed;
float InArmProfileExponent;
float InArmRadialGrowth;
float InArmHostFalloff;
float InBulgeConcentration;
float InBackgroundConcentration;
float InNoiseOctaves;
float InNoiseRidged;
float InNoiseEnable;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint Index = DispatchThreadId.x;

    // ECHO THE PARAMETERS, at a FIXED index, before any arithmetic or guard.
    //
    // Everything downstream depends on these: CellIndex is Index / CandidateBudget,
    // so a CandidateBudget of zero makes that division undefined, the resulting
    // CellIndex fails the NumCells guard, and every thread returns -- zero threads,
    // no marker, Candidates reading zero. That is every symptom we have, and it is
    // indistinguishable from the dispatch never running.
    //
    // The previous marker could not test it, because its own index was computed from
    // the parameters it was meant to be checking. Index 0 is valid in any buffer we
    // allocate, so this one lands whatever the parameters say.
    //
    // Costs entity 0, which becomes a diagnostic record rather than a real entity.
    // Temporary, and worth one entity to end six rounds of inference.
    if (Index == 0u)
    {
        OutEntities[0] = float4(123456.0f, float(NumCells),
                                float(CandidateBudget), float(SlotStride));
    }

#if GALAXY_ENTITYGEN_PROBE_ONLY
    // Everything below is skipped, but every parameter above is still declared and
    // bound exactly as it would be in the real dispatch.
    return;
#endif

    const uint CellIndex = Index / max(CandidateBudget, 1u);
    const uint Slot = Index - CellIndex * max(CandidateBudget, 1u);

    if (CellIndex >= NumCells)
    {
        return;
    }

    // SENTINEL, written through the STRUCTURED uav before anything can reject.
    //
    // Zero counters have two causes that look identical from the CPU: the dispatch
    // never ran, or it ran and the writes are not landing. The counters go through a
    // typed RWBuffer and the entities through a structured one, so writing a marker
    // to the entity buffer separates them -- if the marker arrives, the shader
    // executed and the typed UAV is the problem.
    // Tallied here, BEFORE the per-cell budget test rather than after acceptance.
    // A cell buffer that failed to bind reads as zeros, so Cell.Candidates would be
    // zero, every thread would return, and a shader that ran perfectly well would
    // report no threads at all.
    uint ThreadTally;
    InterlockedAdd(OutCounts[CellIndex * 4u + 1u], 1u, ThreadTally);

    FGalaxyGenCell Cell = InCells[CellIndex];

    // What the shader actually READ for this cell, so a binding or layout failure is
    // visible as a value rather than inferred from an absence.
    uint SeenTally;
    InterlockedMax(OutCounts[CellIndex * 4u + 3u], Cell.Candidates, SeenTally);

    // The dispatch stride is the LARGEST per-cell budget, so cells wanting fewer have
    // their surplus threads land here. The large tier shares one budget across its
    // whole active set rather than giving every cell the full amount: its cell count
    // is whatever survives the cull, not a fixed neighbourhood, so per-cell budgeting
    // turns a few thousand cells into hundreds of millions of threads.
    if (Slot >= Cell.Candidates)
    {
        return;
    }

    GalaxyDensityParams P = MakeGalaxyDensityParams(
        InLateralScale, InVerticalScale, InLayerDensity, InNoiseAmount,
        InWarpAmount, InArmAsym, InSpiralTwist, InCentralVoid,
        InNoiseScale, InWarpScale, InNoiseChannelWeights, InNoiseOffset,
        InBoundsFadeStart, InDiscScaleLengthRatio, InDiscVerticalFalloff,
        InDiscFlare, InDiscWarpAmplitude, InDiscWarpPhase, InDiscWarpTwist,
        InDiscLopsidedAmount, InDiscLopsidedPhase, InArmCount, InArmAsymSeed,
        InArmProfileExponent, InArmRadialGrowth, InArmHostFalloff,
        InBulgeConcentration, InBackgroundConcentration,
        InNoiseOctaves, InNoiseRidged, InNoiseEnable);

    GalaxyPlacement Q = MakeGalaxyPlacement(
        Cell.DensityReference, PlaceCompression, PlaceSpawnExponent,
        PlaceExtentMin, PlaceExtentMax, PlaceExtentExponent);

    GalaxyCandidate C = P.MakeCandidate(
        Cell.Centre, Cell.HalfExtent, InvGalaxyExtent,
        Cell.Coord.x, Cell.Coord.y, Cell.Coord.z,
        (int) Slot * 977 + KeySeed);

    // THE WHOLE POINT. GalaxySample reads the volume texture for warp and modulation;
    // SampleAnalytic does not. With InNoiseEnable at zero the two agree exactly, which
    // is what makes the first migration step verifiable against the CPU path before
    // the texture is switched on.
    const float Density = GalaxySample(P, NoiseTex, NoiseTexSampler, C.Norm);

    GalaxyEntity E = P.FinishEntity(Q, C, Density);

    // Recorded BEFORE the acceptance test, so the counters describe what the shader
    // saw rather than only what it kept.
    uint DensityTally;
    InterlockedMax(OutCounts[CellIndex * 4u + 2u], asuint(max(Density, 0.0f)), DensityTally);

    if (E.bValid < 0.5f)
    {
        return;
    }

    // Claim a place in this cell's run. Bounded by SlotStride so an unusually rich
    // cell overflows into nothing rather than into its neighbour's entries.
    uint Local;
    InterlockedAdd(OutCounts[CellIndex * 4u], 1u, Local);

    if (Local >= SlotStride)
    {
        return;
    }

    const uint Base = (CellIndex * SlotStride + Local) * 3u;

    OutEntities[Base + 0u] = float4(E.Pos, E.Extent);
    OutEntities[Base + 1u] = float4(E.Decor, E.Density);
    OutEntities[Base + 2u] = float4(float(Slot), 0.0f, 0.0f, 0.0f);
}
