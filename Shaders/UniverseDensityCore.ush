// UniverseDensityCore.ush
// Cosmic-web density field. Takes four volume textures and never binds one: two UNORM multinoise for the region
// fetches, two signed vector fields for the warp octaves. GPU only -- UniverseDensityRaymarch.ush draws it and
// UniverseEntityGen.usf places entities against it, both through SampleAtPosition, so the render and the
// entities are one function. PARITY RULES are kept so a C++ shim stays cheap to re-attach: suffix every float
// literal, guard every pow() base, no swizzles beyond .x/.y/.z/.w, no integer vectors.
//
// THE WEB is the skeleton of a cellular decomposition -- space divides into cells, each holding one hashed node
// at a void's centre, and a feature is how many nodes are simultaneously nearest (1 void, 2 wall, 3 filament,
// 4 cluster). COUNTED, NOT SORTED: candidates carry a weight falling off with distance, and N = (sum w)^2 /
// (sum w^2) reads k where k nodes tie. COORDINATES are an integer cell plus a fraction, traversal reaching 1e11.

#pragma once

// Names the decode convention at the signature: the only thing in a four-pair list saying which two are signed.
#define Texture3DSigned Texture3D

#define UNIVERSE_POW_EPSILON 1e-6f

// THE NODE WEIGHT is exp2(lambda * (pivot - u)), u being the power-diagram squared distance in small-cell units.
//   WIDTH_TO_LAMBDA  lambda = 3.2 / authored width; half density falls at 0.27 * width from the wall surface.
//   WEIGHT_PIVOT     mean squared distance to the nearest node, so the dominant weight sits near 1.
//   LAMBDA_MAX       caps lambda so the squared accumulator stays inside float32; 100 is a 0.032-cell wall.
//   EXP_HEADROOM     per-candidate exponent ceiling; overflow is a NaN the march spreads down the whole ray.
#define UNIVERSE_WIDTH_TO_LAMBDA 3.2f
#define UNIVERSE_WEIGHT_PIVOT 0.31f
#define UNIVERSE_LAMBDA_MAX 100.0f
#define UNIVERSE_EXP_HEADROOM 55.0f

// Skip threshold for the FINE walk, in powers of two: past this margin the walk is provably pointless. THE
// COARSE WALK IS NOT SKIPPABLE -- a coarse node with a large offset beats every fine candidate.
#define UNIVERSE_LATTICE_SKIP 40.0f

// Step floor handed to the march, as a fraction of the finest wall the field can express. Half, because what
// needs protecting is the wall crossing and half a thickness puts two samples inside one.
#define UNIVERSE_MIN_STEP_FRACTION 0.5f

// Precision wrap, in cells. Warp and region UVs are (cell & MASK + frac) * scale, so the integer part is masked
// and never converted -- exact at 1e11, seamless because every scale is quantized so WRAP * scale is whole, and
// dependent on THE ASSETS TILING, or a volume cropped from a larger field seams at 4096-cell spacing.
#define UNIVERSE_WARP_WRAP_SHIFT 12
#define UNIVERSE_WARP_WRAP_MASK ((1 << UNIVERSE_WARP_WRAP_SHIFT) - 1)
#define UNIVERSE_WARP_WRAP ((float) (1 << UNIVERSE_WARP_WRAP_SHIFT))

// THE FIELD PERIOD is the largest multiple of (WRAP_ALIGN * ratio) under 2^24, where a float32 stops holding
// integers exactly; a torus, not a seam, since the walk wraps at the LOOKUP. BOTH DIVISORS ARE REQUIRED.
#define UNIVERSE_CELL_EXACT_MAX (1 << 24)
#define UNIVERSE_CELL_WRAP_ALIGN (1 << UNIVERSE_WARP_WRAP_SHIFT)

// Reduces a cell index into [0, InPeriod), once per draw and once per sample, never in the walk. Not `%` alone:
// both languages truncate toward zero, so a negative index would hash as a different cell one period away.
int WrapCell(int InValue, int InPeriod)
{
    int r = InValue % InPeriod;
    return (r < 0) ? (r + InPeriod) : r;
}

// Neighbour step for the walk: two compares and a select against a twenty-cycle modulo, at fifty-four calls per
// sample. Requires the sum in [-InPeriod, 2*InPeriod) -- one period of slack, which SampleCell relies on when
// the warp adds a whole-cell carry, and past which it silently returns a wrong index.
int StepCell(int InWrapped, int InOffset, int InPeriod)
{
    int n = InWrapped + InOffset;
    return (n < 0) ? (n + InPeriod) : ((n >= InPeriod) ? (n - InPeriod) : n);
}

// Per-fetch UV phase, separating the coarse and fine large-octave fetches, which share one asset.
#define UNIVERSE_WARP_LARGE_OFFSET_X 0.317f
#define UNIVERSE_WARP_LARGE_OFFSET_Y 0.631f
#define UNIVERSE_WARP_LARGE_OFFSET_Z 0.149f

#define UNIVERSE_WARP_SMALL_OFFSET_X 0.743f
#define UNIVERSE_WARP_SMALL_OFFSET_Y 0.281f
#define UNIVERSE_WARP_SMALL_OFFSET_Z 0.907f

#define UNIVERSE_REGION_A_OFFSET_U 0.523f
#define UNIVERSE_REGION_A_OFFSET_V 0.091f
#define UNIVERSE_REGION_A_OFFSET_W 0.677f

#define UNIVERSE_REGION_B_OFFSET_U 0.137f
#define UNIVERSE_REGION_B_OFFSET_V 0.859f
#define UNIVERSE_REGION_B_OFFSET_W 0.401f

// Every "per cell" unit here is per SMALL cell; the large lattice inherits them scaled by the ratio.
struct UniverseDensityParams
{
    float InvCellSizeSmall; // Small cells per normalized unit; larger is a finer web.
    // Large / small, whole because the offset re-split is integer division, exact at 1e11 where a float is not.
    float LatticeRatio;
    float InvLatticeRatio;
    float LatticeLogRatioSq;
    float CellSizeBias; // Exponent shaping where between the two lattices a region lands.

    // The draw's field offset, integer part carrying magnitude, plus the same offset in large cells; the Rem is
    // that division's remainder, a float since SampleAtPosition only ever adds it to a fraction.
    float3 OffsetFrac;
    int OffsetCellX;
    int OffsetCellY;
    int OffsetCellZ;
    int LargeOffsetCellX;
    int LargeOffsetCellY;
    int LargeOffsetCellZ;

    // Each lattice's period in its own cells; LargeCellPeriod is exactly CellPeriod / LatticeRatio.
    int CellPeriod;
    int LargeCellPeriod;
    float LargeOffsetRemX;
    float LargeOffsetRemY;
    float LargeOffsetRemZ;
    float bLatticeLarge; // 0 when the ratio is 1 and the second walk cannot change anything.

    // PACKED (min, max, bias, unclaimed): the region channel picks where between the extremes a sample falls,
    // and that IS the value. The march accumulates density x volume, so equal densities read as foam.
    float4 WallDensityRange;
    // Exponent on the wall term. Its threshold sits at the measure's own floor, so it reads the tail of
    // out-of-contention candidates; this crushes the tail without touching the on-wall value of exactly 1.
    float4 WallFalloffRange;
    float4 FilamentDensityRange;
    // Weight-halving distance in cells, and the ONE lambda for both features: a second width needs a second set.
    float4 FeatureWidthRange;
    float4 VoidFloorRange; // Ambient everywhere; keeps voids from being empty.

    uint SeedHash; // Seed folded once here rather than per candidate inside CellHash.

    // Power-diagram offset per node, in SQUARED cell units, subtracted from the squared distance so a larger
    // offset claims more space, out-reaching an unoffset neighbour by exactly `spread`. Erodes the 27-cell
    // search as it grows; the window holds while spread stays well under 1.0 minus the dominant u.
    float4 VoidSizeSpreadRange;
    // Warp octaves: .xyz peak displacement in cells, .w texture repeats per cell, quantized into the scalar
    // below. Neither half means anything alone -- shear is amount * scale * G, and past 1 the map folds.
    float4 WarpAmountLargeRange;
    float WarpScaleLarge;
    float4 WarpAmountSmallRange;
    float WarpScaleSmall;
    // Per-axis gain on the decoded displacement: 0 flattens, negative inverts, |w| > 1 gains. WarpLargeWeights.w
    // is NOT an axis -- it is the coarse-tier amplitude follow. WarpSmallWeights.w is unused.
    float4 WarpLargeWeights;
    float4 WarpSmallWeights;

    // TWO VARIANCE FETCHES, EIGHT CHANNELS, splitting structure against appearance at two scales. Two consumers
    // on one channel are monotone in one scalar, so the allocation is the only thing buying independence.
    //
    //   FIELD A, coarse -- what shape the web has
    //     A.x  which lattice (the cell-size blend)   A.y  void size spread
    //     A.z  feature width                         A.w  large warp octave amount
    //   FIELD B, finer -- how it is painted
    //     B.x  wall density                          B.y  wall falloff
    //     B.z  filament density, void floor          B.w  small warp octave amount
    //
    // B.w and half of B.z are free. KEEP THE FOUR SCALES MUTUALLY COPRIME as whole numbers of 1/4096ths, or two
    // re-align every 4096/gcd cells. Shipped: 53 and 119 for the regions, 205 and 2048 for the octaves.
    float RegionScaleA;
    float RegionScaleB;
    // Fetch gates, false only when every consumer is degenerate, so SampleCell's 0.5 fallbacks match exactly.
    float bWarpEnable;
    float bRegionEnableA;
    float bRegionEnableB;

    // Derived here because cell size and feature width both live here; consumed by the march.
    float MinFeatureStep;

    float BoundsFadeStart; // Applied by the march, not by this file -- see BoundsFade. Set >= 1 to disable.
    float BoundsFadeStartSq;
    float InvBoundsFadeSpan;

    // Guards the BASE only, pow(0, p) being undefined for p <= 0; the exponent is unguarded so a negative bias
    // or falloff blows up visibly rather than being absorbed.
    float PowSafe(float x, float p)
    {
        return (x > UNIVERSE_POW_EPSILON) ? pow(x, p) : 0.0f;
    }

    // One raw warp fetch into three displacement axes. NO CENTRING -- these assets are signed already, and an
    // unsigned one has a mean of +0.5, so the web is TRANSLATED by half the amplitude rather than displaced.
    // Structure still forms, in the wrong place; check the asset, not the amplitudes.
    float3 WeightedVector3(float4 RawSample, float4 InWeights)
    {
        float4 c = RawSample * InWeights;

        return float3(c.x, c.y, c.z);
    }

    float VarianceT(float InChannel, float InBias)
    {
        return PowSafe(saturate(InChannel), InBias);
    }

    float VarianceRemap(float InT, float4 InRange)
    {
        return lerp(InRange.x, InRange.y, InT);
    }

    // Node placement hash, bit-exact in both languages: xyz is the node's offset in its cell, w its radius
    // offset. CAST TO uint BEFORE MULTIPLYING, since signed overflow is UB in C++ and a compiler that proves it
    // happens may fold the hash to a constant -- a field with no structure at all. The parallel XOR fold is safe
    // ONLY because every index arrives wrapped non-negative, or a cell would hash identically to its mirror.
    float4 CellHash(int InX, int InY, int InZ)
    {
        uint ux = (uint) InX;
        uint uy = (uint) InY;
        uint uz = (uint) InZ;

        uint n = (ux * 73856093u) ^ (uy * 19349663u) ^ (uz * 83492791u);
        n ^= SeedHash;

        n ^= n >> 16u;
        n *= 0x7feb352du;
        n ^= n >> 15u;
        n *= 0x846ca68bu;
        n ^= n >> 16u;

        const float Inv255 = 1.0f / 255.0f;
        return float4(float(n & 255u) * Inv255,
                      float((n >> 8u) & 255u) * Inv255,
                      float((n >> 16u) & 255u) * Inv255,
                      float((n >> 24u) & 255u) * Inv255);
    }

    // Region fetch. Same masked cell-relative UV as the warp, returned RAW since VarianceT wants a [0,1] lerp
    // factor. ASSUMES NORMALIZED CHANNELS centred at 0.5, or a Range's extremes land where not authored.
    float4 RegionAxes(Texture3D InVarianceTex, SamplerState InVarianceSampler,
                      int InCellX, int InCellY, int InCellZ, float3 InFrac,
                      float InScale, float3 InPhase)
    {
        float3 uv = float3(
            (float(InCellX & UNIVERSE_WARP_WRAP_MASK) + InFrac.x) * InScale + InPhase.x,
            (float(InCellY & UNIVERSE_WARP_WRAP_MASK) + InFrac.y) * InScale + InPhase.y,
            (float(InCellZ & UNIVERSE_WARP_WRAP_MASK) + InFrac.z) * InScale + InPhase.z);

        return InVarianceTex.SampleLevel(InVarianceSampler, uv, 0.0f);
    }

    // One lattice's contribution to the participant count, as (sum w, sum w^2); the caller adds both and
    // divides. Returns a pair rather than using `out`, which has no C++ equivalent. EVERYTHING REACHING HERE IS
    // ALREADY IN THE SHARED METRIC: InDistScale converts this lattice's squared cell units into small-cell units
    // and InUBias carries the suppression, both uniform over the walk, and lambda and pivot are the caller's
    // likewise. TRUNCATION is the one exposure -- a candidate entering at a cell plane sits at squared distance
    // >= 1, so its weight against the dominant one is around 2^-34 at a 0.06 width, a bound that degrades with
    // WIDE features and LARGE spread; past a spread of about 0.8 the honest fix is a wider search.
    float2 LatticeWeightSums(int InCellX, int InCellY, int InCellZ, float3 InFrac,
                             float InLambda, float InPivot,
                             float InResolvedSpread,
                             float InDistScale, float InUBias,
                             int InPeriod)
    {
        float sumW = 0.0f;
        float sumSqW = 0.0f;

        // The wrap happens at the LOOKUP: only the node's identity wraps, so the node past the last cell IS the
        // node at zero, at the correct relative distance. Hoisted per axis: nine selects rather than eighty-one.
        int wrapX[3];
        int wrapY[3];
        int wrapZ[3];
        for (int wi = 0; wi < 3; wi++)
        {
            wrapX[wi] = StepCell(InCellX, wi - 1, InPeriod);
            wrapY[wi] = StepCell(InCellY, wi - 1, InPeriod);
            wrapZ[wi] = StepCell(InCellZ, wi - 1, InPeriod);
        }

        for (int oz = -1; oz <= 1; oz++)
        {
            for (int oy = -1; oy <= 1; oy++)
            {
                for (int ox = -1; ox <= 1; ox++)
                {
                    float4 h = CellHash(wrapX[ox + 1], wrapY[oy + 1], wrapZ[oz + 1]);

                    float dx = float(ox) + h.x - InFrac.x;
                    float dy = float(oy) + h.y - InFrac.y;
                    float dz = float(oz) + h.z - InFrac.z;

                    // h.w^4: the fourth power makes a large offset rare, so a node far exceeding its neighbours
                    // swallows their territory and leaves one wide void -- continuous, unlike a hash threshold.
                    // Not re-centred: a constant on every u only rescales every weight.
                    float hw2 = h.w * h.w;

                    float u = (dx * dx + dy * dy + dz * dz
                             - hw2 * hw2 * InResolvedSpread) * InDistScale
                            + InUBias;

                    // Overflow guard. Lowering the pivot instead underflows the field to void at ratio 3.
                    float w = exp2(min(InLambda * (InPivot - u),
                                       UNIVERSE_EXP_HEADROOM));

                    sumW += w;
                    sumSqW += w * w;
                }
            }
        }

        return float2(sumW, sumSqW);
    }

    // Composition. Both features are the same count at different thresholds -- a wall is N >= 2, a filament N >=
    // 3 -- and the saturates nest them. Only the wall gets an exponent, its threshold alone reading the tail.
    float DensityFromWeb(float InMeasure, float2 InResolvedDensity,
                         float InResolvedWallFalloff, float InResolvedVoidFloor)
    {
        float wall = PowSafe(saturate(InMeasure - 1.0f), InResolvedWallFalloff);

        float filament = saturate(InMeasure - 2.0f);

        return InResolvedDensity.x * wall
             + InResolvedDensity.y * filament
             + InResolvedVoidFloor;
    }

    // Soft horizon for the finite proxy. NOT APPLIED BY SampleAtPosition: this belongs to how the field is
    // VIEWED, and a fade on the placement path would tie where an entity lands to the player's position.
    float BoundsFade(float rBoundsSq)
    {
        if (rBoundsSq <= BoundsFadeStartSq)
        {
            return 1.0f;
        }

        float t = (sqrt(rBoundsSq) - BoundsFadeStart) * InvBoundsFadeSpan;
        return 1.0f - t * t * (3.0f - 2.0f * t);
    }

    // Cell-relative entry point, and the one that survives virtual traversal: the integer part carries
    // magnitude, the fraction carries precision, neither holds 1e11. ORDER IS LOAD-BEARING -- the region fetches
    // run first at the sample's own UNWARPED position, since the region field modulates the warp and anchoring
    // it elsewhere makes the modulation a property of the view; the warp then displaces the fraction and
    // re-splits, and the walks run last. Textures are threaded rather than held as members, HLSL resource types
    // being unportable inside a locally constructed struct.
    float SampleCell(Texture3D InVarianceTexA, SamplerState InVarianceSamplerA,
                     Texture3D InVarianceTexB, SamplerState InVarianceSamplerB,
                     Texture3DSigned InWarpTexLarge, SamplerState InWarpSamplerLarge,
                     Texture3DSigned InWarpTexSmall, SamplerState InWarpSamplerSmall,
                     int InCellX, int InCellY, int InCellZ, float3 InFrac,
                     int InLargeX, int InLargeY, int InLargeZ, float3 InLargeFrac)
    {
        int cx = InCellX;
        int cy = InCellY;
        int cz = InCellZ;
        float3 frac = InFrac;

        int lx = InLargeX;
        int ly = InLargeY;
        int lz = InLargeZ;
        float3 lfrac = InLargeFrac;

        float3 warpDelta = float3(0.0f, 0.0f, 0.0f);

        // Fallbacks when a fetch is skipped: the plain midpoint, NOT run through the bias. Exact, since a fetch
        // is skipped only when every range feeding it is degenerate.
        float2 mDensity = float2(VarianceRemap(0.5f, WallDensityRange),
                                 VarianceRemap(0.5f, FilamentDensityRange));
        float mWallFalloff = VarianceRemap(0.5f, WallFalloffRange);
        float mInvWidth = 1.0f / max(VarianceRemap(0.5f, FeatureWidthRange), 1e-6f);
        float mVoidFloor = VarianceRemap(0.5f, VoidFloorRange);
        float mSpread = VarianceRemap(0.5f, VoidSizeSpreadRange);
        float mWarpLarge = VarianceRemap(0.5f, WarpAmountLargeRange);
        float mWarpSmall = VarianceRemap(0.5f, WarpAmountSmallRange);

        // Never read: bRegionEnableA is forced true whenever a second lattice exists, tLattice zero when not.
        float mLatticeBlend = 0.5f;

        // FIELD A -- structure: which lattice, how much void sizes vary, feature width, large-octave bend. Slow.
        if (bRegionEnableA > 0.5f)
        {
            float4 a = RegionAxes(InVarianceTexA, InVarianceSamplerA,
                                  cx, cy, cz, frac, RegionScaleA,
                                  float3(UNIVERSE_REGION_A_OFFSET_U,
                                         UNIVERSE_REGION_A_OFFSET_V,
                                         UNIVERSE_REGION_A_OFFSET_W));

            mLatticeBlend = VarianceT(a.x, CellSizeBias);

            float voidT = VarianceT(a.y, VoidSizeSpreadRange.z);
            mSpread = VarianceRemap(voidT, VoidSizeSpreadRange);

            float featureWidthT = VarianceT(a.z, FeatureWidthRange.z);
            mInvWidth = 1.0f / max(VarianceRemap(featureWidthT, FeatureWidthRange), 1e-6f);

            mWarpLarge = VarianceRemap(VarianceT(a.w, WarpAmountLargeRange.z),
                                       WarpAmountLargeRange);
        }

        // FIELD B -- appearance, plus the small octave's grain. Faster, and its boundaries falling elsewhere
        // than A's is what makes a province read as one place with variety rather than one hard edge.
        if (bRegionEnableB > 0.5f)
        {
            float4 b = RegionAxes(InVarianceTexB, InVarianceSamplerB,
                                  cx, cy, cz, frac, RegionScaleB,
                                  float3(UNIVERSE_REGION_B_OFFSET_U,
                                         UNIVERSE_REGION_B_OFFSET_V,
                                         UNIVERSE_REGION_B_OFFSET_W));

            mDensity.x = VarianceRemap(VarianceT(b.x, WallDensityRange.z),
                                       WallDensityRange);
            mWallFalloff = VarianceRemap(VarianceT(b.y, WallFalloffRange.z),
                                         WallFalloffRange);

            float filamentT = VarianceT(b.z, FilamentDensityRange.z);
            mDensity.y = VarianceRemap(filamentT, FilamentDensityRange);
            mVoidFloor = VarianceRemap(VarianceT(b.z, VoidFloorRange.z), VoidFloorRange);

            mWarpSmall = VarianceRemap(VarianceT(b.w, WarpAmountSmallRange.z),
                                       WarpAmountSmallRange);
        }

        if (bWarpEnable > 0.5f)
        {
            float bx = float(cx & UNIVERSE_WARP_WRAP_MASK) + frac.x;
            float by = float(cy & UNIVERSE_WARP_WRAP_MASK) + frac.y;
            float bz = float(cz & UNIVERSE_WARP_WRAP_MASK) + frac.z;

            // Both addresses are computed before either fetch so the loads issue together, which is why the
            // small octave samples UNWARPED. SampleLevel, not Sample: derivatives are undefined here.
            float3 uvL = float3(bx * WarpScaleLarge + UNIVERSE_WARP_LARGE_OFFSET_X,
                                by * WarpScaleLarge + UNIVERSE_WARP_LARGE_OFFSET_Y,
                                bz * WarpScaleLarge + UNIVERSE_WARP_LARGE_OFFSET_Z);

            float3 uvS = float3(bx * WarpScaleSmall + UNIVERSE_WARP_SMALL_OFFSET_X,
                                by * WarpScaleSmall + UNIVERSE_WARP_SMALL_OFFSET_Y,
                                bz * WarpScaleSmall + UNIVERSE_WARP_SMALL_OFFSET_Z);

            float4 vL = InWarpTexLarge.SampleLevel(InWarpSamplerLarge, uvL, 0.0f);
            float4 vS = InWarpTexSmall.SampleLevel(InWarpSamplerSmall, uvS, 0.0f);

            float3 dL = WeightedVector3(vL, WarpLargeWeights);
            float3 dS = WeightedVector3(vS, WarpSmallWeights);

            float ampL = mWarpLarge;
            float ampS = mWarpSmall;

            warpDelta = float3(dL.x * ampL + dS.x * ampS,
                               dL.y * ampL + dS.y * ampS,
                               dL.z * ampL + dS.z * ampS);

            float wx = frac.x + warpDelta.x;
            float wy = frac.y + warpDelta.y;
            float wz = frac.z + warpDelta.z;

            // THE TWO OCTAVES REACH THE COARSE LATTICE ON OPPOSITE TERMS:
            //                  WAVELENGTH        AMPLITUDE
            //   large octave   scales            WarpLargeWeights.w
            //   small octave   fixed             scales
            // The large octave shapes the structural bend, so its wavelength must match the cells being bent,
            // hence a UV from the COARSE index; the small octave roughens whatever boundary it lands on, so its
            // amplitude must be a fraction of THAT cell, hence coarse fractional units. FOLD BUDGET on the
            // coarse lattice is (AmountLarge*ScaleLarge/ratio + AmountSmall*ScaleSmall*ratio) * G <= 1.
            float3 coarseDelta = warpDelta;

            if (bLatticeLarge > 0.5f)
            {
                float lbx = float(lx & UNIVERSE_WARP_WRAP_MASK) + lfrac.x;
                float lby = float(ly & UNIVERSE_WARP_WRAP_MASK) + lfrac.y;
                float lbz = float(lz & UNIVERSE_WARP_WRAP_MASK) + lfrac.z;

                float3 uvLC = float3(
                    lbx * WarpScaleLarge + UNIVERSE_WARP_LARGE_OFFSET_X,
                    lby * WarpScaleLarge + UNIVERSE_WARP_LARGE_OFFSET_Y,
                    lbz * WarpScaleLarge + UNIVERSE_WARP_LARGE_OFFSET_Z);

                float4 vLC = InWarpTexLarge.SampleLevel(InWarpSamplerLarge, uvLC, 0.0f);
                float3 dLC = WeightedVector3(vLC, WarpLargeWeights);

                // 0: the same physical displacement on both tiers, so the coarse web bends proportionally less.
                // 1: identical warp geometry at the coarse scale, bending ratio times further in world terms.
                // Bounded either way; this octave cannot exceed the fine tier's shear.
                float ampLC = ampL * lerp(InvLatticeRatio, 1.0f,
                                          saturate(WarpLargeWeights.w));

                coarseDelta = float3(dLC.x * ampLC + dS.x * ampS,
                                     dLC.y * ampLC + dS.y * ampS,
                                     dLC.z * ampLC + dS.z * ampS);
            }

            float lwx = lfrac.x + coarseDelta.x;
            float lwy = lfrac.y + coarseDelta.y;
            float lwz = lfrac.z + coarseDelta.z;

            float lix = floor(lwx);
            float liy = floor(lwy);
            float liz = floor(lwz);

            lx += (int) lix;
            ly += (int) liy;
            lz += (int) liz;
            lfrac = float3(lwx - lix, lwy - liy, lwz - liz);

            float ix = floor(wx);
            float iy = floor(wy);
            float iz = floor(wz);

            cx += (int) ix;
            cy += (int) iy;
            cz += (int) iz;
            frac = float3(wx - ix, wy - iy, wz - iz);
        }

        // ONE DIAGRAM OUT OF TWO LATTICES needs lambda, pivot and the suppression resolved here, because BOTH
        // WALKS MUST SHARE THEM. A COMMON METRIC: ratioSq converts the coarse lattice's squared distances, and
        // its spread, into small-cell units -- without it each lattice has a nearest node at weight ~1, N reads
        // 2 everywhere, and the field is solid white. A ONE-SIDED SUPPRESSION: in a common metric the fine
        // lattice always wins, so the blend adds a uniform amount to every FINE candidate's power distance. The
        // crossover is deliberately not a knife edge, and that mixture IS the mixed-scale structure.
        float tLattice = (bLatticeLarge > 0.5f) ? mLatticeBlend : 0.0f;

        float ratioSq = LatticeRatio * LatticeRatio;

        float latticeGap = UNIVERSE_WEIGHT_PIVOT * (ratioSq - 1.0f);

        // The ramp is the ODDS RATIO: zero at zero, the gap at the midpoint, divergent at one, which
        // extinguishes the fine lattice rather than outvoting it. Linear leaves it filling the coarse voids.
        float odds = tLattice / max(1.0f - tLattice, 1e-4f);
        float suppress = latticeGap * odds;

        float effRatio = 1.0f + (ratioSq - 1.0f) * min(odds, 1.0f);

        // LAMBDA FOLLOWS THE RAMP, geometrically, so both ends of the blend reduce exactly to the single-lattice
        // field at that cell size; fixed, it would give the coarse sheets the fine ones' ABSOLUTE thickness --
        // hairlines around enormous voids. Smoothstep on t, not on the odds, the handover being near-step in t.
        float lamT = saturate((tLattice - 0.35f) * (1.0f / 0.3f));
        lamT = lamT * lamT * (3.0f - 2.0f * lamT);
        float lamRatio = exp2(LatticeLogRatioSq * lamT);
        float lam = min(UNIVERSE_WIDTH_TO_LAMBDA * mInvWidth, UNIVERSE_LAMBDA_MAX)
                  / lamRatio;

        // The pivot tracks where the dominant candidate is, fine typical distance to coarse. Left at the fine
        // value it underflows every weight to zero at ratio 3.
        float uTypical = UNIVERSE_WEIGHT_PIVOT * effRatio;

        // The spread allowance follows LAMBDA'S ramp, not the pivot's: which lattice dominates is lambda's.
        float pivot = uTypical - 0.5f * mSpread * lamRatio;

        // Largest exponent the fine lattice can reach. See UNIVERSE_LATTICE_SKIP.
        float fineCeiling = lam * (pivot + mSpread - suppress);

        float sumW = 0.0f;
        float sumSqW = 0.0f;

        if (fineCeiling > -UNIVERSE_LATTICE_SKIP)
        {
            float2 fine = LatticeWeightSums(cx, cy, cz, frac, lam, pivot,
                                            mSpread, 1.0f, suppress,
                                            CellPeriod);
            sumW += fine.x;
            sumSqW += fine.y;
        }

        if (bLatticeLarge > 0.5f)
        {
            float2 coarse = LatticeWeightSums(lx, ly, lz, lfrac, lam, pivot,
                                              mSpread, ratioSq, 0.0f,
                                              LargeCellPeriod);
            sumW += coarse.x;
            sumSqW += coarse.y;
        }

        // Division guard: on underflow the measure reads zero, which the saturates take as void, not a NaN.
        float measure = (sumW * sumW) / max(sumSqW, 1e-30f);

        float D = DensityFromWeb(measure, mDensity, mWallFalloff, mVoidFloor);

        return D;
    }

    // Decomposes a normalized position into both lattices' cell/frac pairs and samples. The large split is why
    // the ratio is whole: k = ratio*kq + kr gives kq as the coarse index, everything divided staying small.
    float SampleAtPosition(Texture3D InVarianceTexA, SamplerState InVarianceSamplerA,
                           Texture3D InVarianceTexB, SamplerState InVarianceSamplerB,
                           Texture3DSigned InWarpTexLarge, SamplerState InWarpSamplerLarge,
                           Texture3DSigned InWarpTexSmall, SamplerState InWarpSamplerSmall,
                           float3 InNormPos)
    {
        float3 cellPos = InNormPos * InvCellSizeSmall + OffsetFrac;

        // floor, not truncation: truncation folds the boundary at zero and mirrors the web through the origin.
        float fx = floor(cellPos.x);
        float fy = floor(cellPos.y);
        float fz = floor(cellPos.z);

        float3 frac = float3(cellPos.x - fx, cellPos.y - fy, cellPos.z - fz);

        int cx = WrapCell((int) fx + OffsetCellX, CellPeriod);
        int cy = WrapCell((int) fy + OffsetCellY, CellPeriod);
        int cz = WrapCell((int) fz + OffsetCellZ, CellPeriod);

        float3 largePos = float3(
            (LargeOffsetRemX + cellPos.x) * InvLatticeRatio,
            (LargeOffsetRemY + cellPos.y) * InvLatticeRatio,
            (LargeOffsetRemZ + cellPos.z) * InvLatticeRatio);

        float lfx = floor(largePos.x);
        float lfy = floor(largePos.y);
        float lfz = floor(largePos.z);

        float3 lfrac = float3(largePos.x - lfx, largePos.y - lfy, largePos.z - lfz);

        int lx = WrapCell((int) lfx + LargeOffsetCellX, LargeCellPeriod);
        int ly = WrapCell((int) lfy + LargeOffsetCellY, LargeCellPeriod);
        int lz = WrapCell((int) lfz + LargeOffsetCellZ, LargeCellPeriod);

        return SampleCell(InVarianceTexA, InVarianceSamplerA,
                          InVarianceTexB, InVarianceSamplerB,
                          InWarpTexLarge, InWarpSamplerLarge,
                          InWarpTexSmall, InWarpSamplerSmall,
                          cx, cy, cz, frac,
                          lx, ly, lz, lfrac);
    }

};

// Snaps repeats-per-cell to a multiple of 1/WRAP so the masked UV wrap closes; otherwise a hard seam every 4096
// cells that no amplitude tuning hides. floor(x + 0.5), not round(), which differs across the two languages.
float QuantizeScale(float InScale)
{
    return floor(max(InScale, 0.0f) * UNIVERSE_WARP_WRAP + 0.5f) / UNIVERSE_WARP_WRAP;
}

// Floor division. Both languages truncate toward zero; the remainder must stay in [0, divisor) on both sides of
// zero, or the coarse lattice reflects across the origin.
int FloorDiv(int InValue, int InDivisor)
{
    int q = InValue / InDivisor;
    return (InValue < 0 && q * InDivisor != InValue) ? q - 1 : q;
}

// The single place clamping, inversion and derived quantities are computed, called by both the material's Custom
// node and the entity-gen dispatch. CALLED POSITIONALLY by that node, which fails at SHADER compile rather than
// at build, so a parameter is only ever APPENDED. PACKED ARGUMENTS are (min, max, bias, free) except
// CellSizeRange, naming two LATTICES, and RegionScales, carrying the two fetch frequencies; three .w slots carry
// a passenger. NOTHING IS RANGE-CLAMPED, so what remains are division guards; min > max runs the lerp backwards.
UniverseDensityParams MakeUniverseDensityParams(
    float4 InCellSizeRange,
    float InSeed,

    float3 InOffsetCell,
    float3 InOffsetFrac,

    float4 InWallDensityRange,
    float4 InWallFalloffRange,
    float4 InFilamentDensityRange,
    float4 InFeatureWidthRange,
    float4 InVoidFloorRange,

    float4 InVoidSizeSpreadRange,
    float4 InWarpAmountLargeRange,
    float4 InWarpAmountSmallRange,
    float4 InWarpLargeWeights,
    float4 InWarpSmallWeights,
    float4 InRegionScales,

    float InBoundsFadeStart)
{
    UniverseDensityParams P;

    float cellSmall = max(InCellSizeRange.x, 1e-6f);
    P.InvCellSizeSmall = 1.0f / cellSmall;

    // Rounded to a whole number and floored at one; authoring .y below .x collapses to a single lattice.
    float ratio = max(floor(max(InCellSizeRange.y, 0.0f) / cellSmall + 0.5f), 1.0f);
    P.LatticeRatio = ratio;
    P.InvLatticeRatio = 1.0f / ratio;

    P.LatticeLogRatioSq = 2.0f * log2(ratio);
    P.CellSizeBias = InCellSizeRange.z;
    P.bLatticeLarge = (ratio > 1.5f) ? 1.0f : 0.0f;

    P.SeedHash = (uint) ((int) InSeed) * 2654435761u;

    int ratioInt = (int) ratio; // Period before the split, since the split is taken on the reduced index.
    int periodBlock = UNIVERSE_CELL_WRAP_ALIGN * ratioInt;
    int periodReps = max(UNIVERSE_CELL_EXACT_MAX / periodBlock, 1);
    P.CellPeriod = periodBlock * periodReps;
    P.LargeCellPeriod = P.CellPeriod / ratioInt;

    P.OffsetFrac = InOffsetFrac;

    // Reduced here as well as on the CPU: ComputeFieldOffset reduces for float exactness, THIS reduction defines
    // the field's periodicity, so a stale CPU period costs precision and nothing else.
    int kx = WrapCell((int) InOffsetCell.x, P.CellPeriod);
    int ky = WrapCell((int) InOffsetCell.y, P.CellPeriod);
    int kz = WrapCell((int) InOffsetCell.z, P.CellPeriod);
    P.OffsetCellX = kx;
    P.OffsetCellY = ky;
    P.OffsetCellZ = kz;

    int kqx = FloorDiv(kx, ratioInt);
    int kqy = FloorDiv(ky, ratioInt);
    int kqz = FloorDiv(kz, ratioInt);
    P.LargeOffsetCellX = kqx;
    P.LargeOffsetCellY = kqy;
    P.LargeOffsetCellZ = kqz;
    P.LargeOffsetRemX = float(kx - kqx * ratioInt);
    P.LargeOffsetRemY = float(ky - kqy * ratioInt);
    P.LargeOffsetRemZ = float(kz - kqz * ratioInt);

    P.WallDensityRange = InWallDensityRange;
    P.WallFalloffRange = InWallFalloffRange;
    P.FilamentDensityRange = InFilamentDensityRange;
    P.FeatureWidthRange = InFeatureWidthRange;
    P.VoidFloorRange = InVoidFloorRange;

    P.VoidSizeSpreadRange = InVoidSizeSpreadRange;
    P.WarpAmountLargeRange = InWarpAmountLargeRange;
    P.WarpAmountSmallRange = InWarpAmountSmallRange;
    P.WarpScaleLarge = QuantizeScale(InWarpAmountLargeRange.w);
    P.WarpScaleSmall = QuantizeScale(InWarpAmountSmallRange.w);
    P.WarpLargeWeights = InWarpLargeWeights;
    P.WarpSmallWeights = InWarpSmallWeights;

    P.RegionScaleA = QuantizeScale(InRegionScales.x);
    P.RegionScaleB = QuantizeScale(InRegionScales.y);

    P.bWarpEnable = ((InWarpAmountLargeRange.x != 0.0f) || (InWarpAmountLargeRange.y != 0.0f)
                  || (InWarpAmountSmallRange.x != 0.0f) || (InWarpAmountSmallRange.y != 0.0f))
                  ? 1.0f : 0.0f;

    // ONE TEST PER FETCH, listing exactly that fetch's consumers. EVERY RANGE MUST APPEAR IN ITS LIST, or it
    // reverts to its midpoint whenever every other range in the group is degenerate. Only .x and .y are tested.
    P.bRegionEnableA = ((InVoidSizeSpreadRange.x != InVoidSizeSpreadRange.y)
                     || (InFeatureWidthRange.x != InFeatureWidthRange.y)
                     || (InWarpAmountLargeRange.x != InWarpAmountLargeRange.y)
                     || (ratio > 1.5f))
                     ? 1.0f : 0.0f;

    P.bRegionEnableB = ((InWallDensityRange.x != InWallDensityRange.y)
                     || (InWallFalloffRange.x != InWallFalloffRange.y)
                     || (InFilamentDensityRange.x != InFilamentDensityRange.y)
                     || (InVoidFloorRange.x != InVoidFloorRange.y)
                     || (InWarpAmountSmallRange.x != InWarpAmountSmallRange.y))
                     ? 1.0f : 0.0f;

    // Floored at the width the lambda clamp implies, not at zero: past that clamp the finest wall stops
    // narrowing with the pin, so a floor still following it would ask the march for detail the field cannot
    // express. THE FOLD CEILING IS NOT COMPUTED HERE and must be checked by hand against each range's .y:
    //   AmountLarge*ScaleLarge*G_large + AmountSmall*ScaleSmall*G_small <= 1
    float minWidth = max(min(InFeatureWidthRange.x, InFeatureWidthRange.y),
                         UNIVERSE_WIDTH_TO_LAMBDA / UNIVERSE_LAMBDA_MAX);
    P.MinFeatureStep = UNIVERSE_MIN_STEP_FRACTION * minWidth * cellSmall;

    P.BoundsFadeStart = InBoundsFadeStart;
    P.BoundsFadeStartSq = InBoundsFadeStart * InBoundsFadeStart;

    P.InvBoundsFadeSpan = 1.0f / max(1.0f - InBoundsFadeStart, 1e-6f);

    return P;
}

