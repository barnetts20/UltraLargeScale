#pragma once
#include "/UltraLargeScale/GalaxyDensityCore.ush"
// --- RAYMARCH: ANALYTIC SPHERE-BOUNDED DENSITY ACCUMULATION ---
//
// The proxy mesh decides which pixels run; the unit sphere decides where to march.
//
// InStartPos is the shaded point on the proxy surface, in unit-box [0,1] space.
//
// InViewVec is the LOCAL camera vector, surface toward camera. Direction only --
// normalized or not makes no difference.
//
// InCamPosN is the camera in NORMALIZED space, the same frame as the marched position,
// box spanning -1 to 1. NO REMAP IS APPLIED TO IT HERE. Supply it in any other frame and
// the march is silently biased rather than visibly broken -- a wrong camera position
// produces a plausible image at the wrong step sizes. It is a position rather than a
// distance because a distance cannot be recovered from InViewVec, which is unit length.
//
// RETURNS (emission, steps taken, 0, transmittance).
//
// The step count rides in G because cost has no other observer: a march that truncates
// looks identical to one that finished, except that the far half of the volume is not
// there. RAW COUNT, not normalized -- the material divides by whatever range it wants,
// and normalizing here would be one more number to keep in agreement with MaxSteps.
float4 GalaxyRayMarch(GalaxyDensityParams P, Texture3D InTex, SamplerState InSampler,
                      float3 InStartPos, float3 InViewVec, float3 InCamPosN,
                      float InStepRatio, float InMinStep, float InMinSamples, int InMaxSteps,
                      float InDensityScale, float InJitter, float InNoisePower)
{
    // Unit box [0,1] -> normalized galaxy space [-1,1]. Uniform scale, so a direction is
    // identical in both.
    float3 o = 2.0 * (InStartPos - 0.5);
    float3 dir = normalize(-InViewVec);
    float3 camN = InCamPosN;

    float b = dot(o, dir);
    float c = dot(o, o) - 1.0;
    float disc = b * b - c;
    if (disc <= 0.0)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    float sq = sqrt(disc);

    // Origin inside the sphere: clamp the near end. Outside: take the whole chord
    // WITHOUT clamping to zero, because with an inverted-normal proxy the shaded point is
    // the far face and the chord lies at negative t.
    float tEnter = (c < 0.0) ? 0.0 : (-b - sq);
    float tExit = -b + sq;
    if (tExit <= tEnter)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    // DISTANCE FROM THE CAMERA, which is what sets step size. The sample at t sits at
    // o + dir*t and the camera at o - dCam*dir, so their separation is (dCam + t).
    float dCam = dot(o - camN, dir);

    // START AT THE CAMERA WHEN IT IS INSIDE THE VOLUME, or the chord begins behind the
    // viewer and that whole stretch runs at the floor -- the budget spent on geometry
    // nobody can see, before the march reaches anything visible.
    //
    // GUARDED SO IT CAN ONLY SHORTEN THE CHORD. Each condition rules out a way a wrong
    // InCamPosN could empty it instead of trimming it; the fallback is the full chord,
    // which is slower but correct. An emptied chord returns a transparent pixel and reads
    // as view-dependent geometry dropout.
    float tStart = tEnter;
    if (dCam > 0.0 && -dCam > tEnter && -dCam < tExit)
    {
        tStart = -dCam;
    }

    // CONSTANT ANGULAR STEP SIZE, bounded at both ends.
    //
    // A step twice as far away covers twice the distance for the same apparent size, so
    // stepping by a fixed fraction of camera distance keeps every step the same size ON
    // SCREEN. The recurrence s -> s(1 + k) is geometric, making the step count
    // LOGARITHMIC in range rather than linear.
    //
    // InStepRatio is that fraction, authored directly. It is already an angle in the
    // small-angle sense -- a step of k times the distance subtends about k radians -- so
    // nothing here needs the field of view, the viewport size or the View uniform buffer.
    //
    // THE TWO BOUNDS DOMINATE THE COST, not the ratio. Within
    // InMinStep / InStepRatio of the camera the march is uniform at InMinStep and takes
    // chord/InMinStep steps whatever the ratio is; past the range where one step spans
    // the volume it is uniform at maxStep and takes InMinSamples. The ratio decides where
    // between those the transition happens, not how expensive either end is. A step count
    // that will not respond to InStepRatio is one of these bounds.
    //
    // InMinStep is also the only thing stopping a zero ratio from stalling the loop.
    float k = max(InStepRatio, 0.0);
    float minStep = max(InMinStep, 1e-5);
    float maxStep = (tExit - tStart) / max(InMinSamples, 1.0);

    // Jitter shortens the FIRST step only, offsetting each pixel's lattice independently
    // and breaking up the concentric banding a fixed lattice produces. It costs no energy:
    // the loop clamps the last step to the exit, so the total path is unchanged.
    float firstScale = clamp(InJitter, 0.05, 1.0);

    bool bShape = (InNoisePower != 1.0);

    float transmittance = 1.0;
    float emission = 0.0;
    float t = tStart;
    float stepsTaken = 0.0;

    // InMaxSteps is a SAFETY BOUND, not the step count. The bounds above set the count;
    // this only stops a pathological ratio from hanging the shader.
    [loop]
    for (int i = 0; i < InMaxSteps; i++)
    {
        float remaining = tExit - t;
        if (remaining <= 1e-6)
        {
            break;
        }

        // max against ZERO, not just against the floor. A sample behind the camera has a
        // negative separation, and without this a wrong camera position produces negative
        // step lengths and a march that never terminates.
        float stepLen = max(minStep, max(dCam + t, 0.0) * k);
        stepLen = min(stepLen, maxStep);
        if (i == 0)
        {
            stepLen *= firstScale;
        }
        stepLen = min(stepLen, remaining);

        stepsTaken += 1.0;

        // Sampled at the step MIDPOINT. With uniform steps the choice only shifts the
        // result half a step; with steps that grow along the ray, sampling at the near
        // edge weights every interval by its own leading face and biases the whole
        // integral toward the camera.
        //
        // DO NOT ADD A BOX BOUNDS TEST HERE. InStartPos sits exactly on the proxy
        // surface, so a component is exactly 0 or 1 before any FP error, and such a test
        // fails on iteration zero wherever rounding pushes it outside. It is
        // view-direction dependent, so it shows as angle-dependent dropout at silhouettes.
        float density = GalaxySample(P, InTex, InSampler, o + dir * (t + stepLen * 0.5));
        if (bShape)
        {
            density = P.PowSafe(density, InNoisePower);
        }

        // stepLen is already in the units LayerDensity was normalised against, so the
        // accumulated depth through a layer comes out as its authored value directly.
        float alpha = 1.0 - exp(-density * InDensityScale * stepLen);

        // Flat white emission: structure only.
        emission += alpha * transmittance;
        transmittance *= 1.0 - alpha;

        if (transmittance < 0.001)
        {
            break;
        }

        t += stepLen;
    }

    return float4(emission, stepsTaken, 0.0, transmittance);
}
