#pragma once
#include "/UltraLargeScale/GalaxyDensityCore.ush"
// --- RAYMARCH: ANALYTIC SPHERE-BOUNDED DENSITY ACCUMULATION ---
// The proxy mesh decides which pixels run; the unit sphere decides where to march. The ray is built from the
// CAMERA, not the shaded surface, so t is camera distance and the behind/inside cases fall out of one clamp.
//   InViewVec  local camera vector, SURFACE TOWARD CAMERA (CameraVector via TransformVector World->Local).
//   InCamPosN  camera in NORMALIZED space, the -1..1 box, NO REMAP APPLIED. The ray ORIGIN, so a wrong value
//              moves the ray rather than biasing step size: wrong geometry, not a plausible wrong cost.
//   returns    (emission, raw step count, 0, transmittance) -- a truncated march looks like a finished one.
// STEPPING: baseStep = span / StepBudget, h = baseStep * (1 + StepGrowth * t01), t01 being progress along the
// marched span, NOT camera distance, so cost is set up front rather than discovered -- a camera-relative step
// collapses toward the floor on close approach and runs the ceiling budget every close pass, with four marchers
// possibly on screen. StepBudget is a BUDGET, NOT A COUNT: growth overshoots the span early, giving
// StepBudget * ln(1 + growth) / growth steps, mirrored by FGalaxyMaterialParams::GetEffectiveStepCount. CALLED
// POSITIONALLY by a Custom node that fails at SHADER compile, so only ever APPEND; MaxSteps is
// int(StepBudget) + 8 there, and the four texture pairs are held here but read only by the core.
float4 GalaxyRayMarch(GalaxyDensityParams P,
                      Texture3DSigned InWarpTexDisc, SamplerState InWarpSamplerDisc,
                      Texture3DSigned InWarpTexHalo, SamplerState InWarpSamplerHalo,
                      Texture3D InNoiseTexDisc, SamplerState InNoiseSamplerDisc,
                      Texture3D InNoiseTexHalo, SamplerState InNoiseSamplerHalo,
                      float3 InViewVec, float3 InCamPosN,
                      float InStepBudget, float InStepGrowth, int InMaxSteps,
                      float InDensityScale, float InJitter, float InNoisePower)
{
    float3 o = InCamPosN;
    float3 dir = normalize(-InViewVec);

    float b = dot(o, dir);
    float c = dot(o, o) - 1.0;
    float disc = b * b - c;
    if (disc <= 0.0)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    float sq = sqrt(disc);

    float tEnter = -b - sq;
    float tExit = -b + sq;

    // BEHIND THE CAMERA is a real case: inverted proxy normals let its far face rasterize from behind.
    if (tExit <= 0.0)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    // CAMERA INSIDE THE VOLUME falls out of the same clamp: tEnter is negative there, so zero starts at the
    // camera. Trimming matters because step size is a fraction of the SPAN, so an untrimmed stretch behind the
    // viewer would be budgeted as if visible.
    float tStart = max(tEnter, 0.0);
    if (tExit <= tStart)
    {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    float span = max(tExit - tStart, 1e-6);
    float baseStep = span / max(InStepBudget, 1.0);

    // The FIELD'S floor, not an authored distance (GALAXY_MIN_STEP_FRACTION); it can only lengthen a step.
    float minStep = max(P.MinFeatureStep, 1e-5);

    float growth = max(InStepGrowth, 0.0);
    float invSpan = 1.0 / span;

    // Shortens the FIRST step only, breaking up the banding a fixed lattice produces. Costs no energy.
    float firstScale = clamp(InJitter, 0.05, 1.0);

    bool bShape = (InNoisePower != 1.0);

    float transmittance = 1.0;
    float emission = 0.0;
    float t = tStart;
    float stepsTaken = 0.0;

    // A SAFETY BOUND, not the count; it belongs just above StepBudget -- below it the march truncates silently.
    [loop]
    for (int i = 0; i < InMaxSteps; i++)
    {
        float remaining = tExit - t;
        if (remaining <= 1e-6)
        {
            break;
        }

        // t01 is saturated rather than trusted: tStart past tExit would drive the step negative and hang.
        float t01 = saturate((t - tStart) * invSpan);
        float stepLen = max(baseStep * (1.0 + growth * t01), minStep);
        if (i == 0)
        {
            stepLen *= firstScale;
        }
        stepLen = min(stepLen, remaining);

        stepsTaken += 1.0;

        // Sampled at the step MIDPOINT: with steps that grow along the ray, sampling at the near edge weights
        // every interval by its leading face and biases the integral toward the camera. DO NOT ADD A BOUNDS TEST
        // HERE -- the chord already bounds the march, and a redundant one drops silhouettes on rounding.
        float density = GalaxySample(P,
            InWarpTexDisc, InWarpSamplerDisc,
            InWarpTexHalo, InWarpSamplerHalo,
            InNoiseTexDisc, InNoiseSamplerDisc,
            InNoiseTexHalo, InNoiseSamplerHalo,
            o + dir * (t + stepLen * 0.5));
        if (bShape)
        {
            density = P.PowSafe(density, InNoisePower);
        }

        // stepLen is already in the units LayerDensity was normalised against.
        float alpha = 1.0 - exp(-density * InDensityScale * stepLen);

        emission += alpha * transmittance; // flat white: structure only
        transmittance *= 1.0 - alpha;

        if (transmittance < 0.001)
        {
            break;
        }

        t += stepLen;
    }

    return float4(emission, stepsTaken, 0.0, transmittance);
}
