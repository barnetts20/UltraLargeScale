// UniverseEntityGen.usf
// GPU entity placement against the universe density field, sampling the same field the material
// draws so placement and rendering agree. One group per cell; the group id, unwrapped by
// DispatchGroupsX, is the cell index. UNIVERSE_ENTITYGEN_PASS picks the pass: 0 probes each cell
// for an envelope and a mass, 1 draws candidates against it and needs 0 to have run over the same
// batch. Identity is (CellIndex, Slot) and travels in the record; storage order is
// scheduling-dependent and nothing may key off it.

#include "/Engine/Public/Platform.ush"
#include "/UltraLargeScale/UniversePlacement.ush"

// Globally compacted output, two uint4 per entity, matching FUniverseEntityOut so the readback
// memcpys straight in: [0] asuint(Pos.xyz) with Pos relative to the cell centre, asuint(Extent);
// [1] PackUniverseDecor(Decor), Slot, CellIndex, asuint(Density). Typed, not structured:
// AddClearUAVPass needs a format, and an uncleared cursor makes InterlockedAdd return a huge
// index so every write fails the bounds test silently.
RWBuffer<uint4> OutEntities;

// Five counters per cell plus a global tail. asuint is monotonic for non-negative floats, so
// InterlockedMax over the bit pattern orders exactly as the float does.
//   [i*5+0] accepted   [i*5+1] candidates evaluated   [i*5+3] max candidate density, asuint
//   [i*5+2] envelope, asuint -- written by pass 0, read by pass 1
//   [i*5+4] mass: mean of (density/BudgetAnchor)^PlaceSpawnExponent over the jittered probes,
//           which the CPU solves BudgetScale from
//   [NumCells*5+0] global append cursor   [NumCells*5+1+s] accepted count for slot s
// Per-slot counters keep counting past SlotCapacity, so the final value is that slot's true demand.
// [1] over NumCells*UNIVERSE_ENTITYGEN_PROBES is the candidate/probe cost ratio; [3] above [2] means
// the probes under-estimated the cell and flattened its peak, visible as grid artifacts.
RWBuffer<uint> OutCounts;

// The dispatched batch, geometry only -- the shader derives envelope and budget itself.
// Padding keeps every vector off a sixteen-byte boundary; a straddler packs differently on
// some backends and shifts every field after it silently.
struct FUniverseGenCell
{
    int3 CentreCell; // whole field cells, wrapped into [0, period) by the caller
    float HalfExtent; // caller's units
    float3 CentreFrac; // remainder of the centre within CentreCell, [0,1)
    uint SlotIndex; // which buffer region this cell's entities belong to
    int3 Coord; // the placement key; NOT the dispatch index, and NOT wrapped
    uint Pad1; // 48 bytes total, matching the C++ mirror without packing rules
};

StructuredBuffer<FUniverseGenCell> InCells;

uint NumCells;
uint EntityCapacity; // records in OutEntities

// Many cells share one slot and the buffer reserves SlotCapacity records for each. The cap is
// load-bearing: with only the global cursor, slots whose groups run early fill and the rest get
// nothing, so the population follows GPU scheduling -- entities in voids, emptiness in filaments.
uint NumSlots;
uint SlotCapacity;

// Width of the wrapped group grid. Groups are laid out 2D because a subdivided grid exceeds
// the 65535-per-dimension dispatch limit; the tail of the last row returns early.
uint DispatchGroupsX;

float BudgetScale; // per-tier constant; accepted_i = BudgetScale * mass_i. Pass 1 only.
int KeySeed; // universe seed folded with the tier's seed offset

// Caller units -> the field's normalized frame: reciprocal of the RAY MARCH PROXY'S half extent,
// not the sector extent and not this tier's grid. No traversal term -- the proxy is camera-pegged,
// so the material's offset push cancels and a point scaled by this is bit-for-bit the point the
// material marches at the same place.
float InvFieldExtent;

// Divides the mass in pass 0 and the envelope in pass 1 and cancels exactly out of the
// result; it only keeps per-cell masses near 1. Not a tuning knob.
float BudgetAnchor;

// Widens the probed peak to cover the sampling miss: a finite probe set under-shoots a sharp
// peak falling between its samples. Watch counter [3] against [2] for residual clipping.
float EnvelopePad;

// Placement shaping; the per-cell envelope overrides Q.InvDensityReference.
float PlaceSpawnExponent;
float PlaceExtentMin;
float PlaceExtentMax;
float PlaceExtentExponent;

// Two UNORM multinoise volumes for the region axes, two signed vector volumes for the warp octaves,
// matching the material's Custom node pin for pin. ALL FOUR OR NONE: a stale texture places entities
// against a field nobody renders, so the CPU refuses to dispatch unless every one resolves.
Texture3D VarianceTexA;
SamplerState VarianceTexASampler;
Texture3D VarianceTexB;
SamplerState VarianceTexBSampler;
Texture3D WarpTexLarge;
SamplerState WarpTexLargeSampler;
Texture3D WarpTexSmall;
SamplerState WarpTexSmallSampler;

// Raw, in the order MakeUniverseDensityParams takes them. A pre-derived struct would have to match
// HLSL packing against the C++ layout, where one straddling float3 shifts everything after it.
// FUniverseDensityParams::FillShaderParameters writes these names, so a change breaks both sides.
float4 InCellSizeRange;
float InSeed;
float3 InOffsetCell;
float3 InOffsetFrac;
float4 InWallDensityRange;
float4 InWallFalloffRange;
float4 InFilamentDensityRange;
float4 InFeatureWidthRange;
float4 InVoidFloorRange;
float4 InVoidSizeSpreadRange;
float4 InWarpAmountLargeRange;
float4 InWarpAmountSmallRange;
float4 InWarpLargeWeights;
float4 InWarpSmallWeights;
float4 InRegionScales;
float InBoundsFadeStart;

// Lanes per group, and probes per round. Both groupshared arrays are sized on it and both
// reductions iterate to it.
#define UNIVERSE_ENTITYGEN_GROUP 64u

// Probes per lane. The envelope is a MAX over thin filaments in a mostly-empty volume, so one round
// under-estimates cell peaks by an order of magnitude at every cell size. Subdivision is the wrong
// lever: it raises probe density but multiplies group count. Four rounds gives one clipped
// cell in a hundred at a C/P ratio near 0.1; tune against both counters, never one.
#define UNIVERSE_ENTITYGEN_PROBE_ROUNDS 2u
#define UNIVERSE_ENTITYGEN_PROBES (UNIVERSE_ENTITYGEN_GROUP * UNIVERSE_ENTITYGEN_PROBE_ROUNDS)

// Probed peak; groupshared has no float atomics, so it reduces as bit patterns.
groupshared uint GroupEnvelopeBits;

// Shaped densities, summed by lane 0 in fixed order. Float addition is not associative and
// this sum divides the tier's budget, so an atomic would let scheduling decide the low bits.
groupshared float GroupMass[UNIVERSE_ENTITYGEN_GROUP];

[numthreads(UNIVERSE_ENTITYGEN_GROUP, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
    const uint CellIndex = GroupId.y * DispatchGroupsX + GroupId.x;

    if (CellIndex >= NumCells)
    {
        return;
    }

    FUniverseGenCell Cell = InCells[CellIndex];

    // The cell's own field offset added to the dispatch-wide one: integer field cell plus fraction,
    // so every float afterwards is a small offset inside one cell. NEVER PASS AN ABSOLUTE CENTRE --
    // caller space tracks VirtualTraversal without bound, at 5e13 a float32 ulp is ~4e6, so every
    // probe collapses onto one value and the cell reports no mass while the raymarch draws fine.
    UniverseDensityParams P = MakeUniverseDensityParams(
        InCellSizeRange,
        InSeed,
        InOffsetCell + float3(Cell.CentreCell),
        InOffsetFrac + Cell.CentreFrac,
        InWallDensityRange,
        InWallFalloffRange,
        InFilamentDensityRange,
        InFeatureWidthRange,
        InVoidFloorRange,
        InVoidSizeSpreadRange,
        InWarpAmountLargeRange,
        InWarpAmountSmallRange,
        InWarpLargeWeights,
        InWarpSmallWeights,
        InRegionScales,
        InBoundsFadeStart);

    const float InvAnchor = 1.0f / max(BudgetAnchor, 1e-6f);
    const float Exponent = max(PlaceSpawnExponent, 1e-3f);

#if UNIVERSE_ENTITYGEN_PASS == 0
    // PASS 0 -- cull the cell, envelope it, weigh it. The probe pattern is identical in both
    // passes, so a cell's measured mass is the estimate its own group produces.
    if (GroupIndex == 0u)
    {
        GroupEnvelopeBits = 0u;
    }

    GroupMemoryBarrierWithGroupSync();

    float LocalPeak = 0.0f;
    float LocalMass = 0.0f;

    // Strided, so lane n takes probes n, n+64, ..., keeping hash inputs adjacent in a wave.
    for (uint Round = 0u; Round < UNIVERSE_ENTITYGEN_PROBE_ROUNDS; ++Round)
    {
        const uint ProbeIndex = Round * UNIVERSE_ENTITYGEN_GROUP + GroupIndex;

        // Offset FROM the cell centre; the centre lives in P as an exact integer cell. Hash
        // inputs are Coord and KeySeed only, so the pattern reproduces on every visit.
        const float3 ProbePos = MakeUniverseProbe(
            float3(0.0f, 0.0f, 0.0f), Cell.HalfExtent,
            Cell.Coord.x, Cell.Coord.y, Cell.Coord.z,
            KeySeed, ProbeIndex);

        // The same function acceptance uses, and the UNFADED one -- UniverseRayMarch applies
        // BoundsFade. A faded probe would tie every cell's count to the camera at generation.
        const float ProbeDensity = max(
            P.SampleAtPosition(VarianceTexA, VarianceTexASampler,
                VarianceTexB, VarianceTexBSampler,
                WarpTexLarge, WarpTexLargeSampler,
                WarpTexSmall, WarpTexSmallSampler,
                float3(ProbePos.x * InvFieldExtent,
                       ProbePos.y * InvFieldExtent,
                       ProbePos.z * InvFieldExtent)), 0.0f);

        LocalPeak = max(LocalPeak, ProbeDensity);

        // Probes 0-7 are the cell's vertices: they belong in the MAX, since a wall on a corner
        // is what jitter alone misses, but not in the MEAN, where extremes bias the mass.
        if (ProbeIndex >= 8u)
        {
            LocalMass += pow(ProbeDensity * InvAnchor, Exponent);
        }
    }

    InterlockedMax(GroupEnvelopeBits, asuint(LocalPeak));

    GroupMass[GroupIndex] = LocalMass;
    GroupMemoryBarrierWithGroupSync();

    if (GroupIndex == 0u)
    {
        float Sum = 0.0f;
        for (uint l = 0u; l < UNIVERSE_ENTITYGEN_GROUP; ++l)
        {
            Sum += GroupMass[l];
        }

        float Envelope = asfloat(GroupEnvelopeBits) * EnvelopePad;

        // Runaway stop: the envelope raised to the spawn exponent IS the candidate budget, so a
        // garbage value costs millions of candidates per cell rather than a wrong picture. The field
        // cannot exceed its three resolved maxima; cells pinned here mean the parameters are wrong.
        Envelope = min(Envelope, UniverseAnalyticCeiling(P) * EnvelopePad);

        // Written before any early-out: envelope zero is an empty cell, expected and common,
        // while a slot still at the cleared value means the group never reached here.
        OutCounts[CellIndex * 5u + 2u] = asuint(max(Envelope, 0.0f));

        // Every probe except the eight corners.
        const float MassSamples = float(UNIVERSE_ENTITYGEN_PROBES - 8u);

        OutCounts[CellIndex * 5u + 4u] = asuint(Sum / MassSamples);
    }

#else
    // PASS 1 -- the cell draws BudgetScale * (envelope/anchor)^g candidates and accepts each with
    // probability (density/envelope)^g, so accepted = BudgetScale * mass_i: the envelope cancels,
    // keeping per-cell normalisation free of grid artifacts. No floor or ceiling -- a cell-constant
    // multiplier is a visible cube on a cubic grid; UniverseStochasticCount keeps the expectation.
    const float Envelope = asfloat(OutCounts[CellIndex * 5u + 2u]);

    if (!(Envelope > 0.0f))
    {
        return;
    }

    const float RawCandidates = BudgetScale * pow(Envelope * InvAnchor, Exponent);

    // Runaway stop, not a tuning cap: reachable only if calibration returned a mass near zero,
    // meaning the probes found nothing anywhere and the inputs are wrong.
    const uint Candidates = UniverseStochasticCount(
        RawCandidates, Cell.Coord.x, Cell.Coord.y, Cell.Coord.z, KeySeed, 4194304.0f);

    // Zero is ordinary: most of the web is void, so the budget is often under one candidate.
    if (Candidates == 0u)
    {
        return;
    }

    UniversePlacement Q = MakeUniversePlacement(
        Envelope, PlaceSpawnExponent,
        PlaceExtentMin, PlaceExtentMax, PlaceExtentExponent);

    // Strided so consecutive lanes take consecutive slots. No surplus-thread early-out because
    // the loop bound IS the budget.
    for (uint Slot = GroupIndex; Slot < Candidates; Slot += UNIVERSE_ENTITYGEN_GROUP)
    {
        // Zero centre as in pass 0: C.Pos is caller units relative to the cell centre, C.Norm
        // that offset normalised. C.Pos is written out, so the entity record is cell-relative.
        UniverseCandidate C = MakeUniverseCandidate(
            float3(0.0f, 0.0f, 0.0f), Cell.HalfExtent, InvFieldExtent,
            Cell.Coord.x, Cell.Coord.y, Cell.Coord.z,
            (int) Slot * UNIVERSE_SLOT_STRIDE + KeySeed);

        const float Density = P.SampleAtPosition(
            VarianceTexA, VarianceTexASampler,
            VarianceTexB, VarianceTexBSampler,
            WarpTexLarge, WarpTexLargeSampler,
            WarpTexSmall, WarpTexSmallSampler,
            C.Norm);

        UniverseEntity E = FinishUniverseEntity(Q, C, Density);

        // Counted BEFORE acceptance, so they describe what the shader saw rather than what it
        // kept, and [3] stays comparable against the envelope in [2].
        InterlockedAdd(OutCounts[CellIndex * 5u + 1u], 1u);
        InterlockedMax(OutCounts[CellIndex * 5u + 3u], asuint(max(Density, 0.0f)));

        if (E.bValid < 0.5f)
        {
            continue;
        }

        InterlockedAdd(OutCounts[CellIndex * 5u], 1u); // per-cell tally; it bounds nothing

        // Taken BEFORE the global claim, so a full slot costs nothing further and cannot
        // consume another slot's room.
        uint SlotPrev;
        InterlockedAdd(OutCounts[NumCells * 5u + 1u + Cell.SlotIndex], 1u, SlotPrev);

        if (SlotPrev >= SlotCapacity)
        {
            continue;
        }

        // The per-slot ceilings sum to EntityCapacity, so this is the bounds test on the write
        // rather than a real constraint -- a UAV write past the end is undefined, not clamped.
        uint Global;
        InterlockedAdd(OutCounts[NumCells * 5u], 1u, Global);

        if (Global >= EntityCapacity)
        {
            continue;
        }

        const uint Base = Global * 2u;

        // Integers carrying float bit patterns, never the reverse: an arbitrary pattern read as
        // a float can be a denormal or NaN. It also keeps Slot and CellIndex exact past 2^24.
        OutEntities[Base + 0u] = uint4(asuint(E.Pos), asuint(E.Extent));
        OutEntities[Base + 1u] = uint4(PackUniverseDecor(E.Decor), Slot, CellIndex, asuint(E.Density));
    }
#endif
}
