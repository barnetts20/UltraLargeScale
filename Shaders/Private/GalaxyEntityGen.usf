// GalaxyEntityGen.usf
// Entity placement on the GPU, so the generator sees the SAME field the material draws
// -- warp and texture modulation included. Placement that cannot reach the volume
// texture has to pay for every feature analytically, which is a constraint on what the
// field can reasonably contain, not just a parity problem.
//
// ONE GROUP PER CELL, not one thread per candidate.
//
// A cell has to be culled and given a rejection envelope before any of its candidates
// can be drawn, and that envelope is a max over GALAXY_ENTITYGEN_PROBES samples -- a
// reduction, which a lone thread can only do serially. A group runs the probes in parallel, reduces
// through group memory, then spends itself on that cell's candidates.
//
// DO NOT SPLIT IT INTO CULL + INDIRECT DISPATCH. That needs a compacted cell list, and
// compaction by atomic append makes a cell's output offset depend on scheduling.
// Identity has to be (cell, slot); here the group id IS the cell index, and it is stable.

#include "/Engine/Public/Platform.ush"
#include "/UltraLargeScale/GalaxyPlacement.ush"

// ---------------------------------------------------------------------------
// OUTPUT
//
// COMPACTED GLOBALLY: one atomic cursor for the whole dispatch, entities appended in
// arrival order, and the buffer sized on what the slots can hold rather than on
// cells x worst case.
//
// Reserving a fixed run per cell instead costs either the readback or the picture. The
// run has to be wide enough for the densest cell and every cell pays for it, so a grid
// of a few thousand cells wants hundreds of megabytes; size the run to what fits and the
// dense cells clip against it, emitting an identical count whatever they hold. A
// cell-constant count is a cubic lattice in the sky, and the cells that clip hardest are
// the arms.
//
// SO IDENTITY TRAVELS IN THE RECORD. Identity is (cell, slot), never position in the
// output, or a region regenerates with its entities shuffled between visits. Storage
// order is scheduling-dependent and NOTHING DOWNSTREAM MAY KEY OFF IT; the set, and each
// entity's identity within it, is not.
//
// Two uint4s per entity, matching FGalaxyEntityOut in GalaxyEntityGen.h so the readback
// memcpys straight into it:
//   [0] asuint(Pos.xyz), asuint(Extent)
//   [1] PackGalaxyDecor(Decor), Slot, CellIndex, asuint(Density)
// ---------------------------------------------------------------------------
// TYPED, not structured, for both buffers. A structured UAV has no format, and RDG's
// clear path needs one -- AddClearUAVPass over a structured UAV leaves the buffer at
// whatever the allocator handed back. Uncleared, InterlockedAdd returns a huge index,
// every entity fails the bounds test below, and the cell writes nothing at all while
// looking entirely healthy.
RWBuffer<uint4> OutEntities;
// FIVE slots per cell, plus ONE global past the end:
//   [0] accepted
//   [1] candidates evaluated
//   [2] the cell's ENVELOPE, as asuint
//   [3] the largest density any CANDIDATE saw, as asuint
//   [4] the cell's MASS -- mean of (density/anchor)^exponent over its probes, as asuint
//
//   [NumCells*5 + 0] the global entity append cursor
//
// [4] is not a diagnostic. It is how the candidate budget stops being an authored
// number: accepted_i works out to BudgetScale x mass_i exactly, so one per-tier constant
// sets every cell's count. The CPU reduces these masses and hands the answer back as
// BudgetScale -- see GalaxyDataGenerator::GetTierBudgetScale for which reduction. Nothing
// here reduces anything.
//
// The other three answer questions with no other observer:
//
//   [1] candidates evaluated. Against the probe count -- cells x GALAXY_ENTITYGEN_PROBES
//       -- it gives the ratio that says whether GenerationSubdivision is on the right side
//       of its crossover, since probes and candidates are both field evaluations.
//   [2] against the anchor -- is the normaliser in a sane numeric range?
//   [3] against [2] -- THE ENVELOPE CHECK. A candidate density above the envelope means
//       the probes under-estimated this cell, the ratio clipped at 1, and the peak was
//       flattened. Cell-quantised, so it shows as grid artifacts.
//
// asuint is monotonic for non-negative floats, so InterlockedMax over the bit pattern
// orders exactly as the float does. The masses are read back as floats and never
// atomically combined, so no ordering question arises.
RWBuffer<uint> OutCounts;

// ---------------------------------------------------------------------------
// DISPATCH
//
// A batch of cells, one group each, SUPPLIED rather than derived from the group id:
// which cells exist is the grid owner's business, so a streamed neighbourhood and a whole
// culled grid are the same dispatch with different contents. That is data, not a second
// path.
// ---------------------------------------------------------------------------
// GEOMETRY ONLY -- a centre, a half extent, and the grid coord that keys the cell. The
// shader derives the envelope and the candidate budget itself, so nothing about the
// field crosses the boundary.
//
// The padding is split so no vector straddles a sixteen-byte boundary: Centre and
// HalfExtent fill the first register, Coord and Pad0 the second, Pad1 the third. A
// straddling member packs differently on some backends and every field after it reads
// shifted -- silently.
struct FGalaxyGenCell
{
    float3 Centre; // caller's units
    float HalfExtent;
    int3 Coord; // the placement key; NOT the dispatch index
    uint Pad0;
    uint4 Pad1; // 48 bytes total, matching the C++ mirror without packing rules
};

StructuredBuffer<FGalaxyGenCell> InCells;

uint NumCells;
uint EntityCapacity; // records in OutEntities

// Width of the WRAPPED group grid, in groups.
//
// One group per cell, and a tier's subdivided grid runs to hundreds of thousands of
// them -- past the 65535-per-dimension dispatch limit, which RDG catches as an ensure
// and then dispatches nothing at all. So the groups are laid out two-dimensionally and
// unwrapped here. The tail of the last row is out of range and returns below.
uint DispatchGroupsX;

// The per-tier constant. accepted_i = BudgetScale x mass_i, so this is the whole of the
// tier's placement tuning. Calibrated once per tier; unused by the probe pass.
float BudgetScale;

int KeySeed; // galaxy seed folded with the tier's seed offset
float InvGalaxyExtent;

// A NUMERICAL NORMALISER, not a tuning knob: it divides the mass in pass 0 and the
// envelope in pass 1, and cancels out of the result exactly. Keeping the per-cell masses
// near 1 is all it does. See kBudgetAnchor in GalaxyEntityGen.h.
float BudgetAnchor;

// Turns the probed peak into an envelope the field will not exceed. Covers the SAMPLING
// miss only: a finite probe set under-shoots a sharp peak that falls between its samples.
// Watch counter [3] against [2] for how often that still happens.
float EnvelopePad;

// --- placement, per dispatch; the per-cell envelope overrides Q.InvDensityReference
float PlaceSpawnExponent;
float PlaceExtentMin;
float PlaceExtentMax;
float PlaceExtentExponent;

// FOUR FIELD TEXTURES, matching the material's Custom node pin for pin. Two signed vector
// volumes for the warp fetches, two UNORM multinoise volumes for the modulation fetches,
// split by family as well as by role. See the table in GalaxyDensityCore.ush.
//
// ALL FOUR OR NONE. Placement samples the field the material draws, so a dispatch bound
// with three of these and a stale fourth places stars against a field nobody renders.
Texture3D WarpTexDisc;
SamplerState WarpTexDiscSampler;
Texture3D WarpTexHalo;
SamplerState WarpTexHaloSampler;
Texture3D NoiseTexDisc;
SamplerState NoiseTexDiscSampler;
Texture3D NoiseTexHalo;
SamplerState NoiseTexHaloSampler;

// --- field parameters, raw, in the order MakeGalaxyDensityParams takes them -------
// RAW, NOT PRE-DERIVED. Uploading a derived GalaxyDensityParams as a constant buffer
// would have to match HLSL's packing rules against the C++ layout member for member, and
// one straddling float3 silently shifts everything after it. Deriving here costs sixteen
// arm hashes and a tan per thread, and it cannot drift.
float4 InLateralScale;
float4 InVerticalScale;
float4 InLayerDensity;
float4 InNoiseAmount;
float4 InWarpAmount;
float4 InArmAsym;
float4 InSpiralTwist;
float3 InCentralVoid;
float4 InNoiseScale;
float4 InWarpScale;
float4 InNoiseChannelWeights;
float3 InNoiseOffset;
float InBoundsFadeStart;
float InDiscScaleLengthRatio;
float InDiscVerticalFalloff;
float InDiscFlare;
float InDiscWarpAmplitude;
float InDiscWarpPhase;
float InDiscWarpTwist;
float InDiscLopsidedAmount;
float InDiscLopsidedPhase;
float InArmCount;
float InArmAsymSeed;
float InArmProfileExponent;
float InArmRadialGrowth;
float InArmHostFalloff;
float InBulgeConcentration;
float InBackgroundConcentration;
float InNoiseEnable;
float4 InFieldOrientation;

// Lanes per group. Both groupshared arrays are sized on it and the mass reduction
// iterates to it.
#define GALAXY_ENTITYGEN_GROUP 64u

// PROBES PER LANE, so GALAXY_ENTITYGEN_PROBES samples per cell. The envelope is a MAX over
// the cell, and a galaxy's features are thin: a disc a few percent of the extent thick, and
// arms narrow in azimuth inside it. So the structure occupies a small fraction of any cell
// at any subdivision, and ONE PROBE PER LANE MISSES IT.
//
// TWO FAILURES, NOT ONE, and they look nothing alike. A cell whose probes all miss reports
// a zero envelope and returns before drawing anything -- a hard, cell-shaped hole with the
// raymarch still drawing structure through it. A cell whose probes mostly miss reports a
// mass near zero and draws almost no candidates, which is the same hole with soft edges.
// Both are decided by a coin flip per cell, so they land in a pattern with the generation
// grid's frequency and no relation to the field.
//
// SUBDIVISION IS NOT THE LEVER FOR THIS. Shrinking cells raises the probe DENSITY but also
// multiplies the group count, so total probe cost rises the same way while occupancy and
// scheduling get worse. Adding rounds raises density at constant group count, the cheaper
// axis whenever the group count is already adequate.
//
// TUNE AGAINST BOTH COUNTERS, NEVER ONE. Probes and candidates are both field evaluations,
// so the C/P ratio is the whole cost argument; the live-cell count and the envelope-exceeded
// count are what say whether the probe set is adequate.
#define GALAXY_ENTITYGEN_PROBE_ROUNDS 2u
#define GALAXY_ENTITYGEN_PROBES (GALAXY_ENTITYGEN_GROUP * GALAXY_ENTITYGEN_PROBE_ROUNDS)

// The probed peak, reduced across the group. asuint is monotonic for non-negative
// floats, so InterlockedMax over the bit pattern orders exactly as the float does --
// groupshared memory has no float atomics.
groupshared uint GroupEnvelopeBits;

// The shaped densities, summed by ONE LANE IN A FIXED ORDER rather than by atomics.
// This value divides the tier's whole budget, so every cell's contribution has to be
// reproducible; float addition is not associative, and an atomic would let scheduling
// decide the low bits. Sixty-four adds on one lane costs nothing.
groupshared float GroupMass[GALAXY_ENTITYGEN_GROUP];

[numthreads(GALAXY_ENTITYGEN_GROUP, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
    const uint CellIndex = GroupId.y * DispatchGroupsX + GroupId.x;

    if (CellIndex >= NumCells)
    {
        return;
    }

    FGalaxyGenCell Cell = InCells[CellIndex];

    GalaxyDensityParams P = MakeGalaxyDensityParams(
        InLateralScale, InVerticalScale, InLayerDensity, InNoiseAmount,
        InWarpAmount, InArmAsym, InSpiralTwist, InCentralVoid,
        InNoiseScale, InWarpScale, InNoiseChannelWeights, InNoiseOffset,
        InBoundsFadeStart, InDiscScaleLengthRatio, InDiscVerticalFalloff,
        InDiscFlare, InDiscWarpAmplitude, InDiscWarpPhase, InDiscWarpTwist,
        InDiscLopsidedAmount, InDiscLopsidedPhase, InArmCount, InArmAsymSeed,
        InArmProfileExponent, InArmRadialGrowth, InArmHostFalloff,
        InBulgeConcentration, InBackgroundConcentration,
        InNoiseEnable, InFieldOrientation);

    const float InvAnchor = 1.0f / max(BudgetAnchor, 1e-6f);
    const float Exponent = max(PlaceSpawnExponent, 1e-3f);

#if GALAXY_ENTITYGEN_PASS == 0
    // -----------------------------------------------------------------------
    // PASS 0 -- PROBE. Cull the cell, envelope it, and weigh it.
    //
    // GALAXY_ENTITYGEN_PROBE_ROUNDS probes per lane, and identical for calibration and for
    // generation -- both descend to the same grid, so a cell's measured mass is the
    // estimate its own thread group would produce.
    //
    // PROBE COUNT MATTERS MORE THAN IT LOOKS. The envelope is a MAX, and structure much
    // thinner than a cell is only found if a probe lands on it, so a sparse set makes the
    // estimate a coin flip that varies cell to cell. The envelope normally cancels out of
    // the result, but it stops cancelling wherever the ratio clips at 1.
    //
    // The MEAN comes from the same samples at no extra cost, and is what the budget is
    // solved from -- but from the jittered ones only. See below.
    // -----------------------------------------------------------------------
    if (GroupIndex == 0u)
    {
        GroupEnvelopeBits = 0u;
    }

    GroupMemoryBarrierWithGroupSync();

    float LocalPeak = 0.0f;
    float LocalMass = 0.0f;

    // STRIDED, so lane n takes probes n, n+64, n+128, ... Consecutive lanes hold consecutive
    // probe indices within a round, which keeps their hash inputs adjacent in a wave; the
    // corner cases all land in round 0 and stay wave-uniform.
    for (uint Round = 0u; Round < GALAXY_ENTITYGEN_PROBE_ROUNDS; ++Round)
    {
        const uint ProbeIndex = Round * GALAXY_ENTITYGEN_GROUP + GroupIndex;

        const float3 ProbePos = MakeGalaxyProbe(
            Cell.Centre, Cell.HalfExtent,
            Cell.Coord.x, Cell.Coord.y, Cell.Coord.z,
            KeySeed, ProbeIndex);

        // THE SAME FUNCTION ACCEPTANCE USES. Probing the analytic field would
        // reintroduce exactly the CPU-versus-GPU mismatch this design removed, and
        // invisibly -- the envelope would simply run small and the ratio would clip
        // across the peaks.
        const float ProbeDensity = max(
            GalaxySample(P,
                WarpTexDisc, WarpTexDiscSampler,
                WarpTexHalo, WarpTexHaloSampler,
                NoiseTexDisc, NoiseTexDiscSampler,
                NoiseTexHalo, NoiseTexHaloSampler,
                ProbePos * InvGalaxyExtent), 0.0f);

        LocalPeak = max(LocalPeak, ProbeDensity);

        // CORNERS COUNT TOWARD THE PEAK, NOT THE MEAN.
        //
        // The first eight probes are the cell's vertices. They belong in a MAX -- a
        // ridge sitting on a corner is exactly what jitter alone would miss -- and they
        // are the worst possible points for a MEAN, because they are the cell's extremes
        // and a disc running through the middle misses every one of them. Samples pinned at
        // the extremes pull the mass estimate down systematically, and the mass is what the
        // tier's whole budget divides by.
        if (ProbeIndex >= 8u)
        {
            LocalMass += pow(ProbeDensity * InvAnchor, Exponent);
        }
    }

    InterlockedMax(GroupEnvelopeBits, asuint(LocalPeak));

    GroupMass[GroupIndex] = LocalMass;
    GroupMemoryBarrierWithGroupSync();

    if (GroupIndex == 0u)
    {
        float Sum = 0.0f;
        for (uint l = 0u; l < GALAXY_ENTITYGEN_GROUP; ++l)
        {
            Sum += GroupMass[l];
        }

        const float Envelope = asfloat(GroupEnvelopeBits) * EnvelopePad;

        // Written before any early-out, so a culled cell is DISTINGUISHABLE from a group
        // that never ran: an envelope of zero is an empty cell, which is expected and
        // common -- most of a galaxy's bounding grid is void -- while a slot still at the
        // cleared value means the group never reached here.
        OutCounts[CellIndex * 5u + 2u] = asuint(max(Envelope, 0.0f));

        // Every probe except the eight corners.
        const float MassSamples = float(GALAXY_ENTITYGEN_PROBES - 8u);

        OutCounts[CellIndex * 5u + 4u] = asuint(Sum / MassSamples);
    }

#else
    // -----------------------------------------------------------------------
    // PASS 1 -- GENERATE.
    //
    // The budget is DERIVED, and from a per-tier constant rather than from anything
    // about this batch: the cell draws BudgetScale x (envelope/anchor)^g candidates.
    //
    // Why that expression: acceptance is (d/envelope)^g, so accepted works out to
    //   BudgetScale x (E/a)^g x mean(d^g)/E^g  =  BudgetScale x mean((d/a)^g)
    //                                          =  BudgetScale x mass_i
    // The envelope cancels, which is what makes per-cell normalisation free of grid
    // artifacts, and the anchor cancels through the calibration, which is why it is not
    // a tuning knob. A cell's count therefore depends on that cell alone.
    //
    // NO FLOOR AND NO CEILING. Both are cell-constant multipliers, and a cell-constant
    // multiplier is a visible cube. The real-valued budget reaches a whole number
    // through GalaxyStochasticCount, which preserves the expectation exactly.
    // -----------------------------------------------------------------------
    const float Envelope = asfloat(OutCounts[CellIndex * 5u + 2u]);

    if (!(Envelope > 0.0f))
    {
        return;
    }

    const float RawCandidates = BudgetScale * pow(Envelope * InvAnchor, Exponent);

    // The ceiling is a RUNAWAY STOP, not a tuning cap: reachable only if calibration
    // returned a mass near zero, which means the probes found nothing anywhere and the
    // inputs are wrong. The CPU says so from the counters.
    const uint Candidates = GalaxyStochasticCount(
        RawCandidates, Cell.Coord.x, Cell.Coord.y, Cell.Coord.z, KeySeed, 4194304.0f);

    // Zero is ordinary, not an error: most of a galaxy is faint enough that a cell's
    // budget is a fraction of one candidate and the draw comes up short. The strided
    // loop below is already a no-op at zero; returning early only skips the placement
    // setup.
    if (Candidates == 0u)
    {
        return;
    }

    GalaxyPlacement Q = MakeGalaxyPlacement(
        Envelope, PlaceSpawnExponent,
        PlaceExtentMin, PlaceExtentMax, PlaceExtentExponent);

    // Strided so consecutive lanes take consecutive slots, keeping hash inputs adjacent
    // within a wave. There is no surplus-thread early-out because the loop bound IS the
    // budget.
    for (uint Slot = GroupIndex; Slot < Candidates; Slot += GALAXY_ENTITYGEN_GROUP)
    {
        GalaxyCandidate C = MakeGalaxyCandidate(
            Cell.Centre, Cell.HalfExtent, InvGalaxyExtent,
            Cell.Coord.x, Cell.Coord.y, Cell.Coord.z,
            (int) Slot * GALAXY_SLOT_STRIDE + KeySeed);

        const float Density = GalaxySample(P,
            WarpTexDisc, WarpTexDiscSampler,
            WarpTexHalo, WarpTexHaloSampler,
            NoiseTexDisc, NoiseTexDiscSampler,
            NoiseTexHalo, NoiseTexHaloSampler,
            C.Norm);

        GalaxyEntity E = FinishGalaxyEntity(Q, C, Density);

        // Both counted BEFORE the acceptance test, so they describe what the shader saw
        // rather than only what it kept. The density max is over every candidate, which
        // is what makes [3] comparable against the envelope in [2].
        InterlockedAdd(OutCounts[CellIndex * 5u + 1u], 1u);
        InterlockedMax(OutCounts[CellIndex * 5u + 3u], asuint(max(Density, 0.0f)));

        if (E.bValid < 0.5f)
        {
            continue;
        }

        // Per-cell tally, for the CPU's diagnostics. It bounds nothing.
        InterlockedAdd(OutCounts[CellIndex * 5u], 1u);

        // The GLOBAL claim. One counter for the dispatch, past the per-cell region so it
        // clears and reads back with everything else.
        //
        // Incremented even when the buffer is full, deliberately: the final value is the
        // TRUE total accepted, which is what the CPU thins against. Clamping would make
        // an overflowing dispatch report exactly full and the thinning would be silently
        // wrong.
        uint Global;
        InterlockedAdd(OutCounts[NumCells * 5u], 1u, Global);

        if (Global >= EntityCapacity)
        {
            continue;
        }

        const uint Base = Global * 2u;

        // AN INTEGER BUFFER carrying the floats as their own bit patterns, not the
        // reverse. A float buffer holding a packed integer looks equivalent and is not:
        // an arbitrary bit pattern read as a float can be a denormal or a NaN, and
        // neither round-trips reliably. A float's bit pattern is always a valid integer,
        // so this direction has no such case -- and it lets Slot and CellIndex stay
        // exact at any magnitude rather than only to 2^24.
        OutEntities[Base + 0u] = uint4(asuint(E.Pos), asuint(E.Extent));
        OutEntities[Base + 1u] = uint4(PackGalaxyDecor(E.Decor), Slot, CellIndex, asuint(E.Density));
    }
#endif
}
